// =============================================================================
// Infrastructure-as-a-Network Platform — Canonical Domain Schema
// =============================================================================
// PostgreSQL (Neon). Domain boundaries, immutability, idempotency, audit, and
// tenant isolation are preserved. Enums are stored as String, JSON as String
// via manual serialization for portability.
//
// Canonical economic pipeline:
//   Event → Verification → Attestation → Contribution → Reward → Ledger → Settlement
//
// Architectural rules enforced by schema:
//  - Published NetworkVersion is immutable (no update path exposed).
//  - Every economically relevant object references the policy/version that produced it.
//  - Ledger is append-only, DOUBLE-ENTRY (every posting balances: sum(amount) = 0).
//  - AuditLog is append-only.
//  - Every tenant-owned entity carries tenant_id.
//  - Idempotency uses reservation (INSERT pending → execute → complete).
//  - Assets are explicitly assigned to networks via AssetNetworkAssignment.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // =========================================================================
  // DATABASE PROVIDER CONTRACT (Phase 4.3 — frozen)
  // =========================================================================
  // Canonical provider: PostgreSQL. The platform is deployed on Vercel with
  // a PostgreSQL database (Neon). PostgreSQL is the ONLY supported provider
  // for production and for all test suites.
  //
  // Concurrency guarantees (FOR UPDATE, FOR UPDATE SKIP LOCKED, NOW(),
  // INTERVAL, RETURNING) are KERNEL INVARIANTS, not environment-conditional
  // optimisations. They are used unconditionally in the service layer. A
  // SQLite database CANNOT run this application — the raw SQL will fail
  // and the generated Prisma client expects a postgresql:// URL.
  //
  // To run database-backed tests locally, use a PostgreSQL instance
  // (Docker, Neon dev branch, or local postgres). Do NOT change this
  // provider to sqlite — that would break the persistence contract.
  // =========================================================================
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// 1. Tenancy
// -----------------------------------------------------------------------------

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  status    String   @default("active") // active | suspended
  plan      String   @default("starter") // starter | growth | enterprise
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  networks       NetworkDefinition[]
  organizations  Organization[]
  operators      Operator[]
  assets         Asset[]
  devices        Device[]
  capabilities   Capability[]
  events         Event[]
  attestations   Attestation[]
  contributions  Contribution[]
  rewardRules    RewardRule[]
  rewards        Reward[]
  ledgerAccounts LedgerAccount[]
  ledgerEntries  LedgerEntry[]
  ledgerPostings LedgerPosting[]
  settlements    Settlement[]
  auditLogs      AuditLog[]
  idempotency    IdempotencyRecord[]
  domainEvents   DomainEvent[]
  platformUsers  PlatformUser[]
  vppPrograms    VppBuyerProgram[]
  vppReservations VppCapacityReservation[]
  vppDispatches  VppDispatch[]
  vppAssignments VppDispatchAssignment[]
  vppBaselines   VppBaseline[]
  vppPortfolioCommitments VppPortfolioCommitment[]
  vppBuyerSettlements VppBuyerSettlement[]
  executions     Execution[]
  executionAssignments ExecutionAssignment[]
  capacityResources CapacityResource[]
  capacityReservations CapacityReservation[]
  capacityCommitments CapacityCommitment[]
  capacityUsages CapacityUsage[]
  baselineEvaluations BaselineEvaluation[]
  // Phase 14A: Node — tenant-scoped protocol participant endpoint.
  nodes            Node[]
  // Phase 14B: Bundle — tenant-scoped data-plane primitive.
  bundles          Bundle[]
  // Phase 14C: Route — tenant-scoped routing plan.
  routes           Route[]
  // Phase 14D: TransportExecution — tenant-scoped transport execution.
  transportExecutions TransportExecution[]
  // Phase 14E: DeliveryConfirmation — tenant-scoped delivery receipts.
  deliveryConfirmations DeliveryConfirmation[]
  // Phase 14F: TransformRecord — tenant-scoped transform provenance records.
  transformRecords       TransformRecord[]
  // WORK-010: TransformRegistryEntry — tenant-scoped transform catalog entries.
  transformRegistryEntries TransformRegistryEntry[]

  @@index([slug])
}

model Organization {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  operators Operator[]
  participantIdentities ParticipantIdentity[]

  @@index([tenantId])
}

// -----------------------------------------------------------------------------
// 2. Network definitions + immutable versioning
// -----------------------------------------------------------------------------

model NetworkDefinition {
  id               String   @id @default(cuid())
  tenantId         String
  name             String
  slug             String
  vertical         String   @default("generic") // generic | energy_vpp | storage | wireless | compute | ...
  status           String   @default("draft") // draft | active | archived
  currentVersionId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versions  NetworkVersion[]
  assetAssignments AssetNetworkAssignment[]
  vppPrograms    VppBuyerProgram[]
  executions     Execution[]
  capacityResources CapacityResource[]
  // NOTE: NodeNetworkMembership.networkId is a plain String (no relation),
  // following the same convention as NetworkResourceMembership. Integrity is
  // enforced at the service layer (node.service.ts validates the network
  // belongs to the tenant before joining).

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model NetworkVersion {
  // IMMUTABLE once publishedAt is set.
  id                String    @id @default(cuid())
  networkId         String
  version           Int
  configurationJson String    // full versioned config: asset_types, capabilities, verification_policy, reward_policy
  // Persisted, versioned baseline policy. Immutable after publication.
  // Contains: selectedStrategy, evaluationId, evaluatedAt, criteria, metrics, status.
  // NULL if no baseline evaluation has been run for this version.
  baselinePolicyJson String?
  // Phase 5: Runtime selection contract.
  // Determines which NetworkRuntime implementation executes work for this
  // version. Immutable after publication (a new runtime choice requires a
  // new NetworkVersion). The RuntimeRegistry resolves this to a concrete
  // InfrastructureRuntime | ProtocolRuntime | HybridRuntime.
  runtimeKind       String    @default("infrastructure") // infrastructure | protocol | hybrid
  publishedAt       DateTime?
  createdAt         DateTime  @default(now())

  network        NetworkDefinition @relation(fields: [networkId], references: [id], onDelete: Cascade)
  capabilities   Capability[]
  rewardRules    RewardRule[]
  events         Event[]
  contributions  Contribution[]
  baselineEvaluations BaselineEvaluation[]
  vppPrograms    VppBuyerProgram[]
  // Phase 12B Slice 3: Executions bound to this immutable version.
  executions     Execution[]

  @@unique([networkId, version])
  @@index([networkId])
}

// -----------------------------------------------------------------------------
// 3. Identity (NO catch-all "Node" abstraction)
// -----------------------------------------------------------------------------

model Operator {
  // A person or organization contributing infrastructure.
  // Designed so reputation can later become portable across tenants.
  id              String   @id @default(cuid())
  tenantId        String
  organizationId  String?
  status          String   @default("active") // active | suspended | offboarded
  displayName     String
  trustScore      Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organization  Organization? @relation(fields: [organizationId], references: [id])
  assets        Asset[]
  contributions Contribution[]
  rewards       Reward[]
  settlements   Settlement[]
  vppReservations VppCapacityReservation[]
  vppAssignments VppDispatchAssignment[]
  executionAssignments ExecutionAssignment[]

  @@index([tenantId])
  @@index([organizationId])
}

// -----------------------------------------------------------------------------
// 4. Asset + Device (an asset can have many devices)
//    + AssetNetworkAssignment (explicit network membership)
// -----------------------------------------------------------------------------

model Asset {
  id            String   @id @default(cuid())
  tenantId      String
  operatorId    String
  assetType     String   // battery | vehicle | storage_server | gpu | wifi_ap | sensor | ...
  name          String
  status        String   @default("registered") // registered | active | retired
  location      String?
  metadataJson  String   @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  operator   Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  devices    Device[]
  events     Event[]
  networkAssignments AssetNetworkAssignment[]
  contributions Contribution[]
  vppReservations VppCapacityReservation[]
  vppAssignments VppDispatchAssignment[]
  executionAssignments ExecutionAssignment[]
  capacityResources CapacityResource[]

  @@index([tenantId])
  @@index([operatorId])
}

/// Explicit assignment of an asset to a network. An asset CANNOT ingest events
/// or earn contributions without an active assignment. This replaces the old
/// "pick the tenant's most recent network" heuristic, which was unsafe for
/// multi-network tenants.
///
/// This model is also the AUTHORITATIVE source of an asset's verified physical
/// capacity for a capability. The `verifiedCapacityKw` field is set when the
/// asset is registered/assigned and is used by the capacity allocator.
/// Callers can NEVER supply physical capacity — it always comes from here.
model AssetNetworkAssignment {
  id              String   @id @default(cuid())
  tenantId        String
  assetId         String
  networkId       String
  capabilityType  String   // which capability this asset provides in this network
  status          String   @default("active") // active | suspended | ended
  effectiveFrom   DateTime @default(now())
  effectiveTo     DateTime?
  createdAt       DateTime @default(now())
  // Authoritative verified physical capacity for this asset+capability.
  // GENERIC (not energy-specific): verifiedQuantity + unit together represent
  // the physical limit for ANY capability type:
  //   energy_discharge → 10 kW
  //   storage_capacity → 100 TB
  //   compute_capacity → 16 GPU
  //   bandwidth → 1 Gbps
  verifiedQuantity String?  // decimal as string
  verifiedUnit     String?  // kW | TB | GPU | Gbps | ...

  asset   Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  network NetworkDefinition @relation(fields: [networkId], references: [id], onDelete: Cascade)

  // Issue 3: allow multiple capabilities per asset per network.
  // A battery can provide energy_discharge + frequency_response + energy_capacity
  // to the same VPP. A server can provide compute + storage + bandwidth.
  @@unique([assetId, networkId, capabilityType])
  @@index([tenantId])
  @@index([assetId])
  @@index([networkId])
}

model Device {
  // Technical interface to an asset. Not the asset itself.
  id            String   @id @default(cuid())
  tenantId      String
  assetId       String
  deviceType    String   // controller | smart_meter | inverter | gateway | ...
  manufacturer  String?
  model         String?
  status        String   @default("provisioned") // provisioned | active | suspended | revoked
  metadataJson  String   @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset       Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  credential  DeviceCredential?
  events      Event[]
  // Phase 14A: Nodes optionally backed by this device (one device may back
  // multiple nodes, but identity does not depend on the device).
  nodes       Node[]

  @@index([tenantId])
  @@index([assetId])
}

model DeviceCredential {
  // Secrets are NEVER stored in plaintext.
  //
  // TERMINOLOGY FIX (task 9): the field is now `verificationKey`, NOT `publicKey`.
  // For HMAC-SHA256 this is a SECRET derived from the provisioning secret — it
  // is NOT a public key and must never be exposed. The name reflects what it is.
  // For future Ed25519 support, this would hold the actual public verifying key.
  id                     String    @id @default(cuid())
  tenantId               String
  deviceId               String    @unique
  credentialType         String    @default("hmac_sha256") // hmac_sha256 | ed25519
  verificationKey        String    // HMAC: derived secret used to verify signatures; Ed25519: public verifying key
  secretHash             String    // hash of the shared provisioning secret
  provisioningSecretHash String?   // one-time provisioning secret hash
  status                 String    @default("active") // active | suspended | revoked
  createdAt              DateTime  @default(now())
  activatedAt            DateTime?
  suspendedAt            DateTime?

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// -----------------------------------------------------------------------------
// 5. Capability (versioned schemas, separate from telemetry)
// -----------------------------------------------------------------------------

model Capability {
  id              String   @id @default(cuid())
  tenantId        String
  networkVersionId String?
  capabilityType  String   // energy_discharge | storage_capacity | bandwidth | compute | measured_output | ...
  schemaVersion   Int      @default(1)
  fieldsJson      String   @default("{}") // field name -> type
  unit            String   @default("unit")
  createdAt       DateTime @default(now())

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  networkVersion  NetworkVersion? @relation(fields: [networkVersionId], references: [id])
  contributions   Contribution[]

  @@index([tenantId])
  @@index([capabilityType])
}

// -----------------------------------------------------------------------------
// 6. Event (generic, immutable, signed)
//    Status flow: queued → (worker picks up) → verified | rejected | failed
//    The API no longer runs verification synchronously — it persists + enqueues.
// -----------------------------------------------------------------------------

model Event {
  id              String   @id @default(cuid())
  tenantId        String
  networkVersionId String
  assetId         String
  deviceId        String?
  // Explicit capability binding — NON-NULL (issue from third review).
  // The application always sets this at ingest time from the asset's network
  // assignment. The database now enforces the same invariant: every event
  // MUST have an explicit capability binding.
  capabilityType  String
  externalEventId String?  // client-supplied event_id for idempotency
  eventType       String   // telemetry | observation | command_ack | usage | measurement
  occurredAt      DateTime
  receivedAt      DateTime @default(now())
  sequence        Int?
  payloadJson     String   @default("{}")
  schemaVersion   Int      @default(1)
  status          String   @default("queued") // queued | processing | verified | rejected | failed
  signature       String?
  idempotencyKey  String?  // for the ingest request
  // Task 2: worker lease. Set when a worker atomically claims the event.
  // Prevents two workers from processing the same event.
  claimedAt       DateTime?
  leaseExpiresAt  DateTime?
  createdAt       DateTime @default(now())

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  networkVersion  NetworkVersion      @relation(fields: [networkVersionId], references: [id])
  asset           Asset               @relation(fields: [assetId], references: [id])
  device          Device?             @relation(fields: [deviceId], references: [id])
  verification    VerificationResult?
  attestations    Attestation[]

  @@unique([tenantId, externalEventId])
  @@index([tenantId])
  @@index([assetId])
  @@index([deviceId])
  @@index([status])
}

model VerificationResult {
  id                   String   @id @default(cuid())
  tenantId             String
  eventId              String   @unique
  policyVersion        Int      // = the NetworkVersion.version that defined the policy (task 6)
  verifierVersion      String
  checksJson           String   @default("[]") // [{ name, status, detail }]
  overallStatus        String   // verified | rejected
  risk                 Float    @default(0)
  confidence           Float    @default(1)
  createdAt            DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([overallStatus])
}

// -----------------------------------------------------------------------------
// 7. Attestation (verified claim about an event — NOT a boolean)
// -----------------------------------------------------------------------------

model Attestation {
  id                        String   @id @default(cuid())
  tenantId                  String
  eventId                   String
  claimType                 String   // valid_measurement | valid_usage | ...
  quantity                  Decimal @db.Decimal(20, 8)
  unit                      String
  status                    String   @default("verified") // verified | disputed | revoked
  verificationPolicyVersion Int      // = NetworkVersion.version (task 6)
  verifierVersion           String
  createdAt                 DateTime @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  contributions Contribution[]

  @@index([tenantId])
  @@index([eventId])
}

// -----------------------------------------------------------------------------
// 8. Contribution (economically valid work — NOT proof, NOT payment)
// -----------------------------------------------------------------------------

model Contribution {
  id               String   @id @default(cuid())
  tenantId         String
  networkVersionId String
  operatorId       String
  assetId          String
  capabilityId     String
  quantity         Decimal @db.Decimal(20, 8)
  unit             String
  startTime        DateTime
  endTime          DateTime
  attestationIdsJson String  @default("[]")
  status           String   @default("created") // created | settled | voided
  policyVersion    Int      // = NetworkVersion.version
  idempotencyKey   String?
  createdAt        DateTime @default(now())

  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  networkVersion  NetworkVersion @relation(fields: [networkVersionId], references: [id])
  operator        Operator       @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  asset           Asset          @relation(fields: [assetId], references: [id])
  capability      Capability     @relation(fields: [capabilityId], references: [id])
  attestations    Attestation[]
  rewards         Reward[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId])
  @@index([operatorId])
  @@index([assetId])
}

// -----------------------------------------------------------------------------
// 8b. Capacity — PLATFORM-LEVEL primitive (redesigned).
//
// Capacity is a RESOURCE. Reservations, commitments, and consumption are
// TRANSACTIONS against that resource. This is a 4-layer model:
//
//   CapacityResource (verified physical capacity for asset+capability)
//       ↓
//   CapacityReservation (operator commits capacity to a program for a window)
//       ↓
//   CapacityCommitment (a dispatch commits some of the reserved capacity)
//       ↓
//   Consumption (actual usage, recorded on completion)
//
// Key invariants:
//   - Sum of active reservations ≤ resource.physicalCapacity
//   - Sum of active commitments ≤ reservation.reservedAmount
//   - Consumption recorded per commitment
//
// This works for ALL verticals:
//   VPP:        10 kW → 8 kW reserved → 6 kW committed → 5.7 kW consumed
//   Storage:    100 TB → 80 TB reserved → 50 TB committed → 40 TB consumed
//   Compute:    16 GPU → 12 GPU reserved → 6 GPU committed → 6 GPU consumed
//   Wireless:   1 Gbps → 800 Mbps reserved → 500 Mbps committed → 350 Mbps consumed
// -----------------------------------------------------------------------------

/// A capacity resource: the verified physical capacity of an asset for a
/// specific capability in a network. Created when the asset is assigned to
/// the network. This is the stable lock target for all capacity operations.
model CapacityResource {
  id              String   @id @default(cuid())
  tenantId        String
  assetId         String
  networkId       String
  capabilityType  String
  // The verified physical capacity (from AssetNetworkAssignment.verifiedQuantity).
  // GENERIC — not energy-specific. The unit is also from the assignment:
  //   energy_discharge → kW
  //   storage_capacity → TB
  //   compute_capacity → GPU
  //   bandwidth → Gbps
  physicalCapacity String  // decimal as string
  unit            String   // kW | TB | GPU | Gbps | ... (resolved from assignment, not hardcoded)
  status          String   @default("active") // active | inactive
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset       Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  network     NetworkDefinition @relation(fields: [networkId], references: [id], onDelete: Cascade)
  reservations CapacityReservation[]

  @@unique([assetId, networkId, capabilityType])
  @@index([tenantId])
  @@index([assetId, capabilityType])
}

/// A capacity reservation: an operator commits capacity to a program for a
/// time window. Multiple non-overlapping reservations can share a resource.
/// Overlapping reservations cannot exceed physicalCapacity.
model CapacityReservation {
  id              String   @id @default(cuid())
  tenantId        String
  resourceId      String
  // The amount reserved from the resource.
  reservedAmount  String   // decimal as string
  // Time window.
  startTime       DateTime
  endTime         DateTime
  // Remaining capacity available for commitments (reserved - committed).
  remainingAmount String   // decimal as string — decremented by commitments
  status          String   @default("active") // active | released | expired
  // What this reservation is for.
  sourceType      String   // vpp_program | storage_contract | ...
  sourceId        String?  // e.g. VppCapacityReservation.id
  createdAt       DateTime @default(now())

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  resource     CapacityResource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  commitments  CapacityCommitment[]

  @@index([tenantId])
  @@index([resourceId])
  @@index([sourceType, sourceId])
}

/// A capacity commitment: a dispatch commits some of a reservation's capacity.
/// Multiple commitments can share a reservation (e.g. 6 kW + 4 kW = 10 kW).
/// Commitments cannot exceed the reservation's remaining amount.
///
/// IMPORTANT: committedAmount + unit represent CAPACITY (e.g. kW), NOT usage
/// (e.g. kWh). Actual usage is recorded separately in CapacityUsage to avoid
/// dimensional confusion (6 kW committed ≠ 5.7 kWh consumed).
model CapacityCommitment {
  id              String   @id @default(cuid())
  tenantId        String
  reservationId   String
  // The capacity committed for this specific job/dispatch (e.g. 6 kW).
  committedAmount String   // decimal as string
  unit            String   // kW | TB | GPU | Gbps | ... (must match resource unit)
  // Time window for this commitment.
  startTime       DateTime
  endTime         DateTime
  // Terminal state: active → consumed | released | expired
  status          String   @default("active") // active | consumed | released | expired
  // What this commitment is for.
  sourceType      String   // vpp_dispatch | storage_job | compute_job | network_request_commitment | ...
  sourceId        String?  // e.g. VppDispatch.id, or `${decisionId}:${allocationReservationId}` for control-plane commitments
  createdAt       DateTime @default(now())
  completedAt     DateTime?

  // Phase 12B Slice 3: explicit FK linking this commitment back to the
  // AllocationReservation that produced it (the architectural improvement —
  // cross-layer relationships use explicit foreign keys, not semantic
  // sourceType/sourceId lookups). Nullable for backward compatibility with
  // VPP/Compute commitments created before Slice 3.
  allocationReservationId String?

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservation CapacityReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  allocationReservation AllocationReservation? @relation(fields: [allocationReservationId], references: [id], onDelete: SetNull)
  usages      CapacityUsage[]

  // Phase 12B Slice 3: DB-level idempotency for commitment creation.
  // The app-level findFirst in createCapacityCommitment already dedupes,
  // but this unique constraint closes the concurrent-insert race window.
  // (sourceId is nullable for legacy rows; SQL NULL semantics mean the
  // constraint only fires when sourceId is non-null.)
  @@unique([tenantId, sourceType, sourceId])
  @@index([tenantId])
  @@index([reservationId])
  @@index([allocationReservationId])
  @@index([sourceType, sourceId])
}

/// A capacity usage record — ACTUAL usage of a committed resource.
/// SEPARATE from the commitment because capacity (kW) and usage (kWh) are
/// different physical dimensions.
///
/// Examples:
///   VPP commitment: 6 kW for 30 min → usage: 2.85 kWh energy delivered
///   Storage commitment: 50 TB for 1 month → usage: 45 TB stored
///   Compute commitment: 6 GPU for 1 hour → usage: 6 GPU-hours consumed
///
/// The generic Contribution system uses these usage records (via attestations)
/// to derive the economically verified contribution quantity.
model CapacityUsage {
  id              String   @id @default(cuid())
  tenantId        String
  commitmentId    String
  // The actual usage quantity + unit (may differ from commitment unit).
  // e.g. commitment = 6 kW, usage = 2.85 kWh (different dimensions).
  quantity        String   // decimal as string
  unit            String   // kWh | TB-hours | GPU-hours | ...
  // Time window of actual usage.
  startTime       DateTime
  endTime         DateTime
  // What produced this usage.
  sourceType      String   // vpp_dispatch | storage_job | ...
  sourceId        String?  // e.g. VppDispatch.id
  // Link to the attestation that verified this usage (optional).
  attestationId   String?
  createdAt       DateTime @default(now())

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  commitment  CapacityCommitment @relation(fields: [commitmentId], references: [id], onDelete: Cascade)

  // Fix 4: one usage per commitment (idempotency — prevents duplicate usage records).
  @@unique([commitmentId])
  @@index([tenantId])
  @@index([sourceType, sourceId])
}

// -----------------------------------------------------------------------------
// 9. Reward (configurable engine — fixed_rate | revenue_share)
// -----------------------------------------------------------------------------

model RewardRule {
  // Versioned reward policy attached to a network version.
  id               String   @id @default(cuid())
  tenantId         String
  networkVersionId String
  ruleType         String   // fixed_rate | revenue_share
  rate             String   // decimal as string for precision
  unit             String
  currency         String   @default("USD")
  ruleVersion      Int      @default(1)
  configJson       String   @default("{}")
  createdAt        DateTime @default(now())

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  networkVersion NetworkVersion  @relation(fields: [networkVersionId], references: [id])
  rewards        Reward[]
  vppPrograms    VppBuyerProgram[]

  @@index([tenantId])
  @@index([networkVersionId])
}

model Reward {
  id              String   @id @default(cuid())
  tenantId        String
  contributionId  String
  operatorId      String
  amount          Decimal @db.Decimal(20, 8)
  currency        String   @default("USD")
  ruleVersion     Int
  ruleId          String
  rule            RewardRule @relation(fields: [ruleId], references: [id])
  status          String   @default("calculated") // calculated | posted | settled | failed
  idempotencyKey  String?
  createdAt       DateTime @default(now())

  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contribution  Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  operator      Operator     @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  settlement    Settlement?

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId])
  @@index([contributionId])
}

// -----------------------------------------------------------------------------
// 10. Ledger — DOUBLE-ENTRY accounting (task 7)
//
// Every posting creates a LedgerPosting (groups the entries) + multiple
// LedgerEntry rows. The sum of amounts in a posting MUST equal zero.
//
// Account types:
//   asset     — cash, settlement_clearing (debit-normal: balance typically < 0)
//   liability — buyer_funds, operator_payable (credit-normal: balance typically > 0)
//   revenue   — platform_revenue (credit-normal: balance typically > 0)
//
// Convention: amount is signed. Positive = credit. Negative = debit.
// For each posting: SUM(amount) = 0.
//
// Example reward posting ($100 to operator, $5 platform fee, funded by buyer):
//   buyer_funds       (liability): -105  (debit: reduces buyer's prepaid funds)
//   operator_payable  (liability): +100  (credit: increases what we owe operator)
//   platform_revenue  (revenue):   +5    (credit: increases platform revenue)
//   Sum: -105 + 100 + 5 = 0  ✓
//
// Example settlement (pay operator $100):
//   operator_payable  (liability): -100  (debit: reduces what we owe)
//   cash              (asset):     +100  (credit: reduces our cash)
//   Sum: -100 + 100 = 0  ✓
// -----------------------------------------------------------------------------

model LedgerAccount {
  id          String   @id @default(cuid())
  tenantId    String
  ownerId     String   // operator id | "platform" | "buyer"
  ownerType   String   // operator | platform | buyer
  accountType String   // asset | liability | revenue (task 7)
  currency    String   @default("USD")
  createdAt   DateTime @default(now())

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entries LedgerEntry[]

  @@unique([tenantId, ownerId, ownerType, accountType, currency])
  @@index([tenantId])
}

/// A posting groups all entries in a single balanced transaction.
model LedgerPosting {
  id             String   @id @default(cuid())
  tenantId       String
  postingType    String   // reward | settlement | funding | adjustment
  referenceType  String?  // reward | settlement | contribution
  referenceId    String?
  idempotencyKey String?
  createdAt      DateTime @default(now())

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entries LedgerEntry[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId])
  @@index([referenceType, referenceId])
}

model LedgerEntry {
  // APPEND-ONLY. Part of a LedgerPosting. Individual entries are NOT idempotent
  // by themselves — idempotency is enforced at the posting level.
  id        String   @id @default(cuid())
  tenantId  String
  postingId String
  accountId String
  amount    Decimal @db.Decimal(20, 8) // signed: +credit / -debit; sum per posting MUST = 0
  currency  String   @default("USD")
  entryType String   // reward_credit | platform_fee | buyer_debit | settlement_debit | settlement_credit | funding_credit | funding_debit
  createdAt DateTime @default(now())

  posting LedgerPosting @relation(fields: [postingId], references: [id], onDelete: Cascade)
  account LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([accountId])
  @@index([postingId])
}

// -----------------------------------------------------------------------------
// 11. Settlement — outbox/worker model (task 8)
//
// createSettlement() only creates the settlement in CREATED state + emits a
// domain event to the outbox. A worker (triggered by the client or cron) picks
// it up, calls the payment provider, and finalizes the ledger.
// -----------------------------------------------------------------------------

model Settlement {
  id               String   @id @default(cuid())
  tenantId         String
  rewardId         String   @unique
  operatorId       String
  amount           Decimal @db.Decimal(20, 8)
  currency         String   @default("USD")
  status           String   @default("created") // created | claiming | submitted | processing | completed | failed | retrying
  idempotencyKey   String?
  provider         String   @default("payswap_sandbox")
  providerPayoutId String?
  failureReason    String?
  // Task 2: worker lease for settlement processing.
  claimedAt       DateTime?
  leaseExpiresAt  DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reward  Reward  @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId])
  @@index([status])
}

// -----------------------------------------------------------------------------
// 12. Audit log (append-only, application-immutable)
// -----------------------------------------------------------------------------

model AuditLog {
  id           String   @id @default(cuid())
  tenantId     String
  actorId      String?
  eventType    String   // tenant.created | network.published | operator.created | ...
  resourceType String
  resourceId   String
  metadataJson String   @default("{}")
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([eventType])
  @@index([resourceType, resourceId])
}

// -----------------------------------------------------------------------------
// 13. Idempotency records — reservation-based (task 3)
//
// Flow:
//   1. INSERT with status='pending', responseJson='' (unique constraint = lock)
//   2. Winner executes the operation
//   3. UPDATE to status='completed', responseJson=<result>
//   4. Losers poll until status='completed', then return the stored response
//
// This closes the check-then-execute race window. If the winner crashes before
// completing, a later request detects the stale pending record (via createdAt
// age) and can reclaim or return a conflict.
// -----------------------------------------------------------------------------

model IdempotencyRecord {
  id           String   @id @default(cuid())
  tenantId     String
  key          String
  resourceType String
  status       String   @default("pending") // pending | completed
  resourceId   String?
  responseJson String   @default("")
  createdAt    DateTime @default(now())
  completedAt  DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key, resourceType])
  @@index([tenantId])
  @@index([status])
}

// -----------------------------------------------------------------------------
// 14. Domain event outbox (Redis/Kafka-replaceable transport abstraction)
// -----------------------------------------------------------------------------

model DomainEvent {
  id           String   @id @default(cuid())
  tenantId     String
  eventType    String   // DeviceEventAccepted | VerificationCompleted | ...
  aggregateId  String
  version      Int      @default(1)
  payloadJson  String   @default("{}")
  occurredAt   DateTime @default(now())
  processed    Boolean  @default(false)

  // VPP-2D-4: Event processing lease for retry workers.
  // Lifecycle: pending → processing → processed (or dead_letter).
  // A worker claims an event by setting processingStatus='processing' +
  // claimedAt + leaseExpiresAt + processingClaimId atomically.
  // FENCING: processingClaimId is a unique token per claim. Every
  // worker-owned write must check processingClaimId matches — this
  // prevents a stale (expired-lease) worker from overwriting a newer
  // worker's result. If the write affects 0 rows, the worker lost its
  // lease and must not overwrite the current state.
  // 'dead_letter' is for malformed/unprocessable events.
  processingStatus  String   @default("pending") // pending | processing | processed | dead_letter
  claimedAt         DateTime?
  leaseExpiresAt    DateTime?
  processingClaimId String?  // fencing token — unique per claim

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([eventType])
  @@index([processed])
  @@index([processingStatus])
  @@index([leaseExpiresAt])
}

// -----------------------------------------------------------------------------
// 15. Platform authentication (NOT tenant-scoped — platform-level identity)
// -----------------------------------------------------------------------------

model PlatformUser {
  // Platform-level user account. Links to a tenant for non-admin roles.
  // Admins have tenantId = null (platform-wide access).
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String   // scrypt hash: salt:hash
  role          String   @default("viewer") // admin | owner | operator | viewer
  tenantId      String?  // null for admin; tenant id for tenant-scoped users
  status        String   @default("active") // active | suspended
  isDemo        Boolean  @default(false)
  displayName   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  waitlistApproved Waitlist[]

  @@index([tenantId])
  @@index([role])
}

model Waitlist {
  // Users who signed up and are waiting for admin approval.
  // Admin can approve (creates a PlatformUser) or reject.
  id            String   @id @default(cuid())
  email         String   @unique
  requestedRole String   @default("owner") // admin | owner | operator | viewer
  reason        String?
  status        String   @default("pending") // pending | approved | rejected
  approvedById  String?  // PlatformUser who approved
  createdUserId String?  // PlatformUser created when approved
  createdAt     DateTime @default(now())
  reviewedAt    DateTime?

  approvedBy    PlatformUser? @relation(fields: [approvedById], references: [id])

  @@index([status])
  @@index([email])
}

// =============================================================================
// 16. VPP Domain Layer (Energy Virtual Power Plant)
// =============================================================================
// These models are VPP-SPECIFIC. They sit ON TOP of the generic platform
// primitives (Event, Attestation, Contribution, Reward, Ledger, Settlement)
// and do NOT modify or duplicate them.
//
// The VPP layer owns:
//   - DER asset types (battery, solar_inverter, ev_charger, smart_meter)
//   - Energy capabilities (energy_discharge, frequency_response, energy_capacity)
//   - Capacity reservations (how much capacity an operator commits to a buyer)
//   - Dispatch events (buyer requests discharge, platform assigns to assets)
//   - Dispatch assignments (which assets discharge how much)
//   - Baseline calculations (what the asset would have done without dispatch)
//   - Performance verification (actual vs baseline = verified contribution)
//
// The VPP layer does NOT create:
//   - EnergyEvent (uses generic Event)
//   - EnergyAttestation (uses generic Attestation)
//   - EnergyContribution (uses generic Contribution)
//   - EnergyReward (uses generic Reward)
//   - EnergyLedger (uses generic LedgerPosting/LedgerEntry)
//   - EnergySettlement (uses generic Settlement)
//
// VPP telemetry → generic Event
// VPP performance proof → generic Attestation
// VPP kWh delivered → generic Contribution
// VPP payment → generic Reward + Ledger + Settlement
// =============================================================================

/// A buyer program defines the commercial terms for VPP participation.
/// e.g. "Grid operator pays $0.12/kWh for discharge during peak hours".
/// Created by the tenant owner; assets are enrolled via CapacityReservation.
model VppBuyerProgram {
  id              String   @id @default(cuid())
  tenantId        String
  networkId       String
  // Bind to the concrete NetworkVersion under which this program was created.
  // The baseline policy, verification policy, and reward rules are resolved
  // from THIS version — never from network.currentVersionId at execution time.
  networkVersionId String
  name            String
  description     String?
  status          String   @default("active") // active | paused | ended
  rewardRuleId    String
  dispatchWindowStart String
  dispatchWindowEnd   String
  pricePerKwh     String
  currency        String   @default("USD")
  minCapacityKw   String
  maxCapacityKw   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  network       NetworkDefinition @relation(fields: [networkId], references: [id], onDelete: Cascade)
  networkVersion NetworkVersion   @relation(fields: [networkVersionId], references: [id])
  rewardRule    RewardRule        @relation(fields: [rewardRuleId], references: [id])
  reservations  VppCapacityReservation[]
  dispatches    VppDispatch[]

  @@index([tenantId])
  @@index([networkId])
  @@index([networkVersionId])
}

/// An operator commits capacity from their assets to a buyer program.
/// This is the VPP-specific reservation layer — it determines how much
/// capacity an asset can contribute before dispatch.
model VppCapacityReservation {
  id              String   @id @default(cuid())
  tenantId        String
  programId       String
  operatorId      String
  assetId         String
  capabilityType  String   // energy_discharge | frequency_response | energy_capacity
  // Reserved capacity (what the operator commits to provide).
  reservedKw      String   // decimal as string
  reservedKwh     String?  // decimal as string (optional energy limit)
  status          String   @default("active") // active | withdrawn | expired
  effectiveFrom   DateTime @default(now())
  effectiveTo     DateTime?
  createdAt       DateTime @default(now())

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  program   VppBuyerProgram   @relation(fields: [programId], references: [id], onDelete: Cascade)
  operator  Operator          @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  asset     Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)

  // Note: NO unique constraint on [programId, assetId, capabilityType] because
  // an asset can have multiple non-overlapping reservations in the same program.
  // Capacity allocation is enforced by the CapacityAllocation model (time-window-aware).
  @@index([tenantId])
  @@index([programId])
}

/// A dispatch event: the buyer requests discharge from the VPP.
/// This is VPP-specific orchestration — it does NOT replace the generic
/// Event model. Instead, it triggers the creation of generic Events (telemetry)
/// for each assigned asset.
model VppDispatch {
  id              String   @id @default(cuid())
  tenantId        String
  programId       String
  // VPP-4.1: Explicit link to the generic Execution record.
  // This is a 1:1 relationship — every VppDispatch has exactly one Execution.
  // Removes the need for findFirst(sourceType + sourceId) lookups.
  executionId     String   @unique
  // The dispatch request.
  requestedKw     String   // decimal as string — total power requested
  requestedKwh    String   // decimal as string — total energy to deliver
  startTime       DateTime // when discharge should begin
  endTime         DateTime // when discharge should end
  // Dispatch status lifecycle (VPP-2D-4 + VPP-3B separated delivery, buyer settlement, and economic finality):
  //   created → assigned → dispatching → delivery_complete → buyer_settlement_pending → completed
  //   dispatching → delivery_complete (all assignments terminal, some failed/reconciliation_required)
  //   delivery_complete → reconciliation_required (if any assignment is reconciliation_required)
  //   delivery_complete → buyer_settlement_pending (all assignments completed/failed, portfolio evaluated)
  //   buyer_settlement_pending → completed (buyer settlement charged or failed with zero charge)
  //   reconciliation_required → buyer_settlement_pending → completed (after all financial reconciliations succeed)
  //
  // "delivery_complete" = all assignments are performance-terminal.
  // "buyer_settlement_pending" = delivery complete + portfolio evaluated, buyer charge pending.
  // "reconciliation_required" = delivery complete, but one+ assignments have unresolved financial recovery.
  // "completed" = portfolio obligation finalized + buyer settlement processed + all financial recovery done.
  //
  // VPP-4.1: The VPP dispatch status includes financial states (buyer_settlement_pending,
  // reconciliation_required) that are ABOVE the generic Execution layer. The generic
  // Execution.status tracks only: created → assigned → executing → completed → failed.
  // VPP maps its richer lifecycle onto the generic one:
  //   VPP delivery_complete → Execution completed
  //   VPP buyer_settlement_pending → Execution completed (already)
  //   VPP reconciliation_required → Execution completed (already) or failed
  //   VPP completed → Execution completed (already)
  status          String   @default("created") // created | assigned | dispatching | delivery_complete | buyer_settlement_pending | reconciliation_required | completed | cancelled | failed
  // Dispatch metadata
  reason          String?  // e.g. "grid_frequency_event", "price_peak", "manual"
  metadataJson    String   @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  program     VppBuyerProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  execution   Execution       @relation(fields: [executionId], references: [id])
  assignments VppDispatchAssignment[]
  portfolioCommitment VppPortfolioCommitment?
  buyerSettlement     VppBuyerSettlement?

  @@index([tenantId])
  @@index([programId])
  @@index([executionId])
  @@index([status])
}

/// A dispatch assignment: which asset discharges how much.
/// Each assignment generates a generic Event (telemetry) when the asset
/// reports its actual discharge. The VPP baseline engine then computes
/// the performance (actual - baseline) which becomes a Contribution.
model VppDispatchAssignment {
  id              String   @id @default(cuid())
  tenantId        String
  dispatchId      String
  // VPP-4.1: Explicit link to the generic ExecutionAssignment.
  // 1:1 — every VppDispatchAssignment has exactly one ExecutionAssignment.
  // Removes findFirst(executionId + assetId) ambiguity.
  executionAssignmentId String @unique
  assetId         String
  operatorId      String
  capabilityType  String   // energy_discharge | frequency_response
  assignedKw      String   // decimal as string — power assigned to this asset
  assignedKwh     String   // decimal as string — energy assigned to this asset
  status          String   @default("assigned") // assigned | dispatching | completed | failed | reconciliation_required | reconciling
  // Durable economic stage tracking for resumable recovery.
  economicStage   String   @default("none") // none | delivery_verified | usage_recorded | reward_calculated | ledger_posted | settlement_pending | completed
  // After completion: actual vs baseline (computed by the baseline engine).
  actualKwh       String?  // decimal as string — measured energy delivered
  baselineKwh     String?  // decimal as string — estimated energy without dispatch
  performanceKwh  String?  // decimal as string — actual - baseline (the contribution quantity)
  // Link to the generic pipeline (filled when the asset reports telemetry).
  eventId         String?  // the generic Event created by the asset's discharge telemetry
  contributionId  String?  // the generic Contribution created from the performance
  // Fix 1: explicit link to the capacity commitment (1:1 per assignment).
  capacityCommitmentId String?
  createdAt       DateTime @default(now())
  completedAt     DateTime?

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dispatch   VppDispatch        @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  executionAssignment ExecutionAssignment @relation(fields: [executionAssignmentId], references: [id])
  asset      Asset              @relation(fields: [assetId], references: [id], onDelete: Cascade)
  operator   Operator           @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  baseline   VppBaseline?

  @@index([tenantId])
  @@index([dispatchId])
  @@index([executionAssignmentId])
  @@index([assetId])
}

/// Baseline calculation record. The baseline engine estimates what an asset
/// would have done without the dispatch (e.g. a battery would have stayed at
/// its current state of charge). The difference (actual - baseline) is the
/// verified contribution.
model VppBaseline {
  id              String   @id @default(cuid())
  tenantId        String
  assignmentId    String   @unique
  // Baseline method used.
  method          String   // average_load | last_week_same_time | model_prediction | zero
  // Baseline values (what the asset would have done without dispatch).
  baselineKw      String   // decimal as string
  baselineKwh     String   // decimal as string
  // Actual values (what the asset did during dispatch).
  actualKw        String   // decimal as string
  actualKwh       String   // decimal as string
  // Performance = actual - baseline (the verified contribution quantity).
  performanceKwh  String   // decimal as string
  // Metadata for auditability.
  metadataJson    String   @default("{}")
  createdAt       DateTime @default(now())

  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignment VppDispatchAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// Durable baseline evaluation record. Created when a strategy evaluation
/// is run. Referenced by NetworkVersion.baselinePolicyJson.
/// Reproducible: contains simulator version, dataset hash, engine version.
model BaselineEvaluation {
  id                  String   @id @default(cuid())
  tenantId            String
  networkVersionId    String?
  evaluationId        String   @unique
  simulatorVersion    String   @default("1.0.0")
  engineVersion       String   @default("1.0.0")
  scenarioDatasetHash String
  numScenarios        Int
  criteriaJson        String
  metricsJson         String
  selectedStrategy    String
  status              String   // accepted | no_acceptable_strategy
  evaluatedAt         DateTime @default(now())
  createdAt           DateTime @default(now())

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  networkVersion  NetworkVersion? @relation(fields: [networkVersionId], references: [id])

  @@index([tenantId])
  @@index([networkVersionId])
}

// -----------------------------------------------------------------------------
// VPP-2D-4: Portfolio Commitment — the buyer-facing obligation fulfillment
// record. Aggregates individual assignment results into a portfolio-level
// assessment: did the platform deliver what it promised the buyer?
//
// ARCHITECTURAL RULE: This model does NOT create new economic objects
// (no PortfolioLedger, no PortfolioReward, no PortfolioSettlement). The
// individual assignment Contributions → Rewards → Ledger → Settlements
// remain the source of truth for operator payments. This model is the
// BUYER-FACING commitment fulfillment record that evaluates:
//   - committed kW (from the optimizer)
//   - delivered kW (aggregate of individual verified performance)
//   - shortfall / overdelivery
//   - fulfillment status (fulfilled | partial | failed)
//
// The buyer settlement (if any) is a separate commercial layer that may
// reference this commitment — but the generic economic kernel is not
// duplicated.
// -----------------------------------------------------------------------------

/// Portfolio-level commitment for a VPP dispatch.
/// Created atomically with the portfolio reservations (VPP-2D-4).
/// Updated when ALL assignments reach a terminal state, aggregating their
/// verified performance into a portfolio fulfillment assessment.
///
/// ARCHITECTURAL RULE: This model does NOT create new economic objects.
/// The individual assignment Contributions → Rewards → Ledger → Settlements
/// remain the source of truth for operator payments. This model is the
/// BUYER-FACING commitment fulfillment record.
model VppPortfolioCommitment {
  id              String   @id @default(cuid())
  tenantId        String
  dispatchId      String   @unique // 1:1 with VppDispatch

  // Link to the portfolio reservation set (VPP-2D-3).
  // This binds the commitment to the actual reservations that were created.
  portfolioReservationId String? // the portfolioId passed to optimizeAndReserve

  // The buyer's request (what was promised).
  requestedKw     String   // decimal as string — buyer's requested power
  requestedKwh    String   // decimal as string — buyer's requested energy
  confidenceLevel String   // decimal as string — e.g. "0.99"

  // The optimizer's commitment (what the platform safely promised).
  committedKw     String   // decimal as string — safe capacity at confidence
  algorithm       String   @default("greedy_lexicographic_marginal_safe_capacity")
  optimalityGuarantee String @default("heuristic")

  // The shortfall policy (tolerance band for fulfillment).
  toleranceThresholdPct String @default("90") // e.g. "90" = 90% required

  // The obligation measurement method (how "delivered" is measured).
  // average_power: deliveredKw = deliveredKwh / durationHours
  // energy:        deliveredKwh directly (no kW conversion)
  // interval_power: future — interval-by-interval fulfillment
  measurementMethod String @default("average_power")

  // The buyer fulfillment basis (how baseline is applied).
  // per_asset_clipped:       Σ max(0, actual_i - baseline_i) — operator contribution
  // aggregate_counterfactual: max(0, Σactual - Σbaseline) — portfolio incremental
  fulfillmentBasis String @default("per_asset_clipped")

  // Aggregate delivered performance (filled at final evaluation).
  // NULL until the portfolio is evaluated (all assignments terminal).
  deliveredKw     String?  // decimal as string — aggregate verified kW
  deliveredKwh    String?  // decimal as string — aggregate verified kWh
  totalBaselineKwh String? // decimal as string — sum of individual baselines
  totalActualKwh  String?  // decimal as string — sum of individual actuals

  // SEPARATED performance measures (VPP-2D-4 correction):
  // Operator contribution = Σ max(0, actual_i - baseline_i)  [per-asset clipped]
  // This is what operators are paid for (never negative per asset).
  operatorContributionKwh String? // decimal as string
  // Raw signed portfolio performance = Σ actual - Σ baseline  [can be negative]
  // This is the true aggregate incremental (before per-asset clipping).
  rawSignedPortfolioPerformanceKwh String? // decimal as string
  // The buyer-delivered kWh = depends on fulfillmentBasis policy.
  // If per_asset_clipped: = operatorContributionKwh
  // If aggregate_counterfactual: = max(0, rawSignedPortfolioPerformanceKwh)
  buyerDeliveredKwh String? // decimal as string

  // Fulfillment assessment.
  fulfillmentPct  String?  // decimal as string — buyerDeliveredKw / committedKw * 100
  // Status lifecycle:
  //   pending → evaluating → (final: fulfilled | partial | failed)
  //   evaluating → pending (on failure, retryable)
  //   final states are idempotent (re-evaluation is a no-op)
  //
  // LEASE: when status='evaluating', evaluationClaimedAt + evaluationLeaseExpiresAt
  // track the evaluator's lease. If the evaluator crashes, the lease expires
  // and recoverStuckPortfolioEvaluations() can reclaim it (revert to 'pending').
  // FENCING: evaluationClaimId is a unique token per claim. Every
  // evaluator-owned write must check evaluationClaimId matches — this
  // prevents a stale (expired-lease) evaluator from overwriting a newer
  // evaluator's result. If the write affects 0 rows, the evaluator lost
  // its lease and must not overwrite the current state.
  status          String   @default("pending") // pending | evaluating | fulfilled | partial | failed
  evaluationClaimedAt     DateTime?
  evaluationLeaseExpiresAt DateTime?
  evaluationClaimId       String?  // fencing token — unique per claim
  evaluatedAt     DateTime?

  // Reconciliation metadata.
  assignmentCount Int      @default(0) // number of assignments in the portfolio
  completedAssignments Int @default(0) // number that reached terminal state
  failedAssignments Int    @default(0) // number that reached 'failed' state
  metadataJson    String   @default("{}")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dispatch  VppDispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([dispatchId])
  @@index([status])
}

// -----------------------------------------------------------------------------
// VPP-3: Buyer Settlement — the buyer-facing commercial charge for a
// completed portfolio commitment. Computes the buyer's payment based on
// delivered energy × price, with shortfall penalty and overdelivery cap.
//
// ARCHITECTURAL RULE: This is a direct ledger posting (buyer_funds debit +
// buyer_revenue credit), NOT a Contribution→Reward chain. Operator payments
// remain on the existing generic pipeline.
// -----------------------------------------------------------------------------

/// Buyer settlement for a VPP dispatch. 1:1 with VppDispatch.
/// Created after the portfolio commitment reaches a final state.
/// Uses claim/lease/fencing for crash-safe processing.
model VppBuyerSettlement {
  id              String   @id @default(cuid())
  tenantId        String
  dispatchId      String   @unique // 1:1 with VppDispatch
  commitmentId    String   // FK to VppPortfolioCommitment

  // Charge breakdown (computed from portfolio fulfillment + contract terms).
  // These fields are a SNAPSHOT of the pricing policy at settlement creation
  // time. They never change — even if VppBuyerProgram.pricePerKwh is later
  // updated, historical settlements use the original pricing.
  buyerDeliveredKwh String   // decimal as string
  pricePerKwh     String   // decimal as string — snapshot from VppBuyerProgram
  deliveredCharge String   // decimal as string — buyerDeliveredKwh × pricePerKwh
  capacityCeiling String   // decimal as string — ceiling based on measurementMethod
  cappedCharge    String   // decimal as string — min(deliveredCharge, capacityCeiling)
  fulfillmentPct  String   // decimal as string
  toleranceThresholdPct String
  metTolerance    Boolean
  buyerCharge     String   // decimal as string — final charge after adjustments
  shortfall       String   // decimal as string — capacityCeiling - buyerCharge
  currency        String   @default("USD")

  // Measurement method from the commitment (average_power | energy).
  measurementMethod String @default("average_power")

  // Versioned pricing policy snapshot (JSON). Contains the full pricing
  // policy used to compute the charge: pricePerKwh, toleranceThresholdPct,
  // measurementMethod, fulfillmentBasis, chargeFormula version.
  // This makes the charge formula explicit and reproducible — historical
  // settlements can be audited without re-reading VppBuyerProgram.
  pricingPolicyJson String  @default("{}")

  // Settlement state with claim/lease/fencing.
  // pending → charging → charged | failed | reconciliation_required
  //
  // 'reconciliation_required': the ledger posting may have partially
  // succeeded (e.g., buyer_funds debit posted but revenue credit failed,
  // or crash after posting but before status update). The settlement
  // must NOT be treated as 'failed' (unknown financial state). A
  // reconciliation process inspects the durable ledger state by
  // idempotency key and resolves the settlement to 'charged' or 'failed'.
  status          String   @default("pending") // pending | charging | charged | failed | reconciliation_required
  claimId         String?  // fencing token — unique per processing attempt
  claimedAt       DateTime?
  leaseExpiresAt  DateTime?
  ledgerPostingId String?  // FK to LedgerPosting
  buyerFundsBalanceAfter String? // decimal as string
  failureReason   String?
  chargedAt       DateTime?
  reconciledAt    DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dispatch  VppDispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([dispatchId])
  @@index([status])
}

// =============================================================================
// GENERIC EXECUTION RUNTIME (Protocol Runtime Phase 2)
// =============================================================================
// Vertical-agnostic execution lifecycle extracted from VppDispatch.
// VPP wraps this; future verticals (storage, compute, wireless) do the same.
// =============================================================================

model Execution {
  id              String   @id @default(cuid())
  tenantId        String
  networkId       String
  // Phase 12B Slice 3: bind the Execution to the immutable NetworkVersion
  // the AllocationDecision was scheduled against. Nullable for backward
  // compatibility with VPP/Compute rows created before Slice 3.
  networkVersionId String?
  requestedQuantity String
  requestedUnit    String
  startTime       DateTime
  endTime         DateTime
  status          String   @default("created")
  sourceType      String
  sourceId        String?
  metadataJson    String   @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  network     NetworkDefinition @relation(fields: [networkId], references: [id], onDelete: Cascade)
  networkVersion NetworkVersion? @relation(fields: [networkVersionId], references: [id], onDelete: SetNull)
  assignments ExecutionAssignment[]
  vppDispatch VppDispatch?    // VPP-4.1: reverse relation (1:1)

  @@unique([sourceType, sourceId])
  @@index([tenantId])
  @@index([networkId])
  @@index([networkVersionId])
  @@index([status])
  @@index([sourceType, sourceId])
}

model ExecutionAssignment {
  id              String   @id @default(cuid())
  tenantId        String
  executionId     String
  assetId         String
  operatorId      String
  capabilityType  String
  assignedQuantity String
  assignedUnit    String
  status          String   @default("assigned")
  actualQuantity  String?
  actualUnit      String?
  verifiedQuantity String?
  verifiedUnit    String?
  eventId         String?
  contributionId  String?
  capacityCommitmentId String?
  createdAt       DateTime @default(now())
  completedAt     DateTime?

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  execution  Execution  @relation(fields: [executionId], references: [id], onDelete: Cascade)
  asset      Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  operator   Operator   @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  vppDispatchAssignment VppDispatchAssignment?  // VPP-4.1: reverse relation (1:1)
  // Phase 12B Slice 5: the execution leases for this assignment (one active
  // at a time — enforced by the partial unique index on ExecutionLease).
  executionLeases ExecutionLease[]
  // Phase 12B Slice 6: the economic pipeline checkpoint (1:1).
  economicPipelineState EconomicPipelineState?

  // Phase 12B Slice 3: DB-level "one assignment per commitment" (the VPP 1:1
  // pattern, now enforced structurally). Nullable capacityCommitmentId rows
  // (legacy or commitments without assignments) are not constrained (SQL NULL
  // semantics). This prevents duplicate assignments for the same commitment on
  // retry, complementing the app-level idempotency.
  @@unique([capacityCommitmentId])
  @@index([tenantId])
  @@index([executionId])
  @@index([assetId])
  @@index([status])
}

/// Phase 12B Slice 5: ExecutionLease — ownership of a physical execution
/// attempt. At most one ACTIVE lease per ExecutionAssignment (DB-enforced via
/// a partial unique index on (executionAssignmentId) WHERE status='active').
///
/// The lease is the fencing token: a worker must hold the current lease to
/// execute/complete. A stale worker (wrong leaseVersion) is rejected by the
/// CAS in renew/complete/fence.
///
/// STATE MACHINE:
///   ACQUIRE → active (workerIdentity set, leaseUntil set)
///     ├─ renew → active (leaseUntil extended, leaseVersion unchanged)
///     ├─ complete → released (assignment completed, capacity consumed)
///     ├─ fence (adapter supportsCancellation=true) → fenced (assignment failed, capacity released)
///     └─ fence (adapter supportsCancellation=false) → unsafe_to_retry
///         (assignment marked fence_required, capacity NOT released — human/ops intervention)
///
/// CRITICAL: lease expiry does NOT auto-transition. An expired lease is
/// detected by recovery, which then decides: fence (if adapter can cancel) or
/// unsafe_to_retry (if it cannot). Expiry is evidence recovery is needed,
/// NOT proof that physical execution stopped.
model ExecutionLease {
  id                      String   @id @default(cuid())
  executionAssignmentId   String
  leaseVersion            Int      // monotonic per assignment; increments on each new attempt
  workerIdentity          String   // the dispatcher/worker that acquired this lease
  leaseUntil              DateTime // when the lease expires (if not renewed)
  status                  String   @default("active") // active | released | fenced | unsafe_to_retry
  acquiredAt              DateTime @default(now())
  renewedAt               DateTime?
  releasedAt              DateTime?
  fencedAt                DateTime?
  fenceReason             String?
  // The fence outcome: 'fenced' (cancellation confirmed, safe to retry) or
  // 'unsafe_to_retry' (adapter cannot cancel, physical execution may still
  // be running — retry is NOT authorized).
  fenceOutcome            String?

  executionAssignment     ExecutionAssignment @relation(fields: [executionAssignmentId], references: [id], onDelete: Cascade)

  // E1 — SINGLE ACTIVE OWNER: at most one active lease per assignment.
  // PostgreSQL partial unique index (defined in the migration) enforces this
  // at the DB level — two concurrent acquireExecutionLease calls cannot both
  // create an active lease for the same assignment.
  @@index([executionAssignmentId])
  @@index([status])
  @@index([leaseUntil])
  @@index([workerIdentity])
}

/// Phase 12B Slice 6: EconomicPipelineState — the generic checkpoint for the
/// Evidence → Verification → Contribution → Reward → Ledger → Settlement pipeline.
///
/// This is NOT a new economic primitive. It is the durable checkpoint +
/// reconciliation layer that ties together the EXISTING generic primitives:
///   - Event (telemetry ingestion + outbox)
///   - VerificationResult (policy-driven verification)
///   - Attestation (verified claim)
///   - Contribution (verified economic activity)
///   - Reward (economic entitlement)
///   - LedgerPosting (double-entry accounting)
///   - Settlement (payment instruction)
///
/// The checkpoint is keyed 1:1 by ExecutionAssignmentId. It records the
/// stage reached, the deterministic idempotency keys used at each stage, and
/// the durable object IDs (eventId, attestationId, contributionId, rewardId,
/// settlementId) so that reconciliation can resume from the exact gap without
/// duplicating downstream outcomes.
///
/// VERTICAL NEUTRALITY: the orchestrator imports no vertical service. The
/// vertical provides the evidence (telemetry payload) + the signing identity
/// (device credential); the orchestrator drives the generic pipeline.
model EconomicPipelineState {
  id                      String   @id @default(cuid())
  executionAssignmentId   String   @unique  // 1:1 with ExecutionAssignment
  tenantId                String
  networkVersionId        String
  networkId               String
  // The current stage of the economic pipeline.
  //   evidence_pending → evidence_recorded → verified → contribution_created
  //   → reward_calculated → ledger_posted → settlement_created → completed
  //   → reconciliation_required (on partial failure)
  stage                   String   @default("evidence_pending")
  // Deterministic idempotency keys for each stage (derived from assignmentId,
  // NOT from Date.now() or randomUUID). Each downstream step uses these keys
  // so retries converge.
  eventIdempotencyKey     String   // used for ingestEvent's externalEventId
  contributionIdempotencyKey String // used for createContribution
  rewardIdempotencyKey    String   // used for calculateReward
  ledgerIdempotencyKey    String   // used for postRewardToLedger
  settlementIdempotencyKey String  // used for createSettlement (auto-derived as reward-${rewardId})
  // Durable object IDs (filled in as each stage completes). NULL until the
  // stage is reached. These are the source of truth for reconciliation —
  // reconciliation inspects these, NOT the stage field.
  eventId                 String?
  attestationId           String?
  contributionId          String?
  rewardId                String?
  ledgerPostingId         String?
  settlementId            String?
  // Reconciliation metadata.
  reconciliationReason    String?
  lastReconciledAt        DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  executionAssignment     ExecutionAssignment @relation(fields: [executionAssignmentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([stage])
  @@index([networkVersionId])
}

// -----------------------------------------------------------------------------
// Phase 9B: Protocol State Snapshots — persistent deterministic state
// -----------------------------------------------------------------------------

/// A persisted protocol state snapshot. Each successful transaction commit
/// produces exactly one new snapshot. The (networkVersionId, version) pair
/// is UNIQUE — this enforces optimistic concurrency at the database level.
///
/// The state is stored as a canonical JSON string (sorted keys) with a
/// deterministic SHA-256 hash. This gives us:
///   - durable state (survives restart)
///   - deterministic replay (getSnapshot by version)
///   - state hashes (same state → same hash)
///   - crash recovery (append-only)
///   - optimistic concurrency (unique version constraint)
///
/// The protocol runtime owns this model — it is NOT used by VPP, Compute,
/// or the generic Execution pipeline.
model ProtocolStateSnapshot {
  id                String   @id @default(cuid())
  networkVersionId  String
  version           Int
  stateJson         String   // canonical JSON (sorted keys)
  stateHash         String   // SHA-256 of stateJson
  createdAt         DateTime @default(now())

  @@unique([networkVersionId, version])
  @@index([networkVersionId])
  @@index([stateHash])
}

/// Phase 9B.1: Protocol Transition Journal — records each state transition.
/// This is the bridge between deterministic execution and consensus:
/// consensus needs something to agree on, and transitions are that thing.
///
/// Each row records:
///   - the transaction that was executed (transactionHash)
///   - the state before (previousStateHash)
///   - the state after (resultStateHash)
///   - the resulting version
///
/// This is append-only — transitions are immutable once recorded.
/// The journal enables:
///   - deterministic replay (re-execute transitions in order)
///   - consensus proof (validators agree on transition order)
///   - audit trail (who did what, when)
///   - crash recovery (reconstruct state from journal)
model ProtocolTransition {
  id                  String   @id @default(cuid())
  networkVersionId    String
  version             Int      // the resulting state version (N+1)
  transactionHash     String   // hash of the executed transaction
  previousStateHash   String   // state hash before the transition
  resultStateHash     String   // state hash after the transition
  createdAt           DateTime @default(now())

  @@unique([networkVersionId, version])
  @@index([networkVersionId])
  @@index([transactionHash])
  @@index([previousStateHash])
}

/// Phase 11B §4.1: PhysicalExecutionEvidence — proves a physical action
/// occurred in the infrastructure world. Content-addressed by evidenceId.
/// Immutable after creation (no update path). Stores resultJson so the intended
/// protocol transaction can be re-derived after a crash (spec §6.3).
///
/// Mirrors the ProtocolStateSnapshot pattern: full state (resultJson) + hash
/// (resultDigest) stored together.
model PhysicalExecutionEvidence {
  evidenceId            String   @id // content-addressed SHA-256
  executionAssignmentId String
  runtimeKind           String   // 'hybrid'
  networkVersionId      String
  resultDigest          String   // SHA-256 of canonical RuntimeExecuteResult
  resultJson            String   // full canonical RuntimeExecuteResult (for re-derivation)
  occurredAt            DateTime

  @@index([executionAssignmentId])
  @@index([networkVersionId])
}

/// Phase 11B §4.2: ReconciliationAttempt — a reconciliation try linking a
/// PhysicalExecutionEvidence to a protocol transaction submission.
///
/// PHASE 11B CORRECTION (attempt lifecycle — fixes the 6e31067 defect where a
/// retry returned the same resolved commitment and was misreported as EXECUTED):
///   Multiple attempts can exist per evidence. A failed terminal attempt can
///   be followed by a NEW attempt that legitimately re-submits.
///
/// C3 (corrected): at most one PENDING attempt per evidence at a time.
///   ENFORCED by a PostgreSQL partial unique index, created by a proper Prisma
///   migration (prisma/migrations/20260817000000_recon_c3_partial_unique/):
///     CREATE UNIQUE INDEX recon_attempt_pending_unique
///       ON "ReconciliationAttempt" ("evidenceId") WHERE "status" = 'PENDING'
///   This is race-proof under PostgreSQL default (READ COMMITTED) isolation:
///   two concurrent INSERTs of PENDING for the same evidenceId cannot both
///   succeed — one will fail with a unique violation. The application-level
///   check-then-insert is NOT relied upon for correctness (Defect 5 fix).
///   The runtime ensureC3UniqueIndex() is a SAFETY NET for environments that
///   haven't run the migration, NOT the primary creation path (Defect 9 fix).
///
/// C4: an attempt never transitions backwards. PENDING → {RECONCILED, <cause>}
///   is the only forward edge. A new attempt is a NEW row.
model ReconciliationAttempt {
  attemptId               String   @id @default(cuid())
  evidenceId             String   // FK to PhysicalExecutionEvidence
  networkVersionId       String
  intendedTransactionId  String   // independently derived from evidence (C2, §6.4)
  sender                 String   // for re-derivation at recovery (§6.3)
  nonce                  Int      // for re-derivation at recovery (§6.3)
  status                 String   // ReconciliationState
  createdAt              DateTime @default(now())
  resolvedAt             DateTime?
  outcomeId              String?  // FK to ProtocolOutcome

  @@index([evidenceId, status]) // supports the partial unique index lookups
  @@index([networkVersionId])
  @@index([status])
  @@index([intendedTransactionId])
}

/// Backward-compat alias for the old name. Prisma doesn't support model
/// aliases, so callers using @prisma/client will reference ReconciliationAttempt.
/// The reconciliation-types.ts PendingCommitment type is an alias for
/// ReconciliationAttempt.

/// Phase 11B §4.3: ProtocolOutcome — durable record of what the protocol layer
/// returned for a given attempt. Content-addressed by outcomeId.
/// Append-only (O2 — now GENUINELY enforced).
///
/// PHASE 11B FIX (Defect 6 — O2 nullable loophole):
///   finalityCertificate is NON-NULLABLE. Pre-finalization outcomes
///   (REJECTED_BY_CONSENSUS, NO_TRANSACTIONS) use the sentinel ''
///   (NO_FINALITY_CERTIFICATE constant) instead of NULL. This makes
///   @@unique([attemptId, finalityCertificate]) actually enforce O2 —
///   PostgreSQL UNIQUE allows multiple NULLs, but treats '' as a real value.
///
/// PHASE 11B FIX (Defect 2): finalityCertificate holds the ACTUAL consensus
/// certificate (SHA-256 of ordered tx IDs), threaded from BatchExecutionResult.
model ProtocolOutcome {
  outcomeId            String   @id // content-addressed SHA-256
  attemptId            String   // FK to ReconciliationAttempt
  transactionId        String   // the ProtocolTransaction.id actually submitted
  finalityCertificate  String   // ACTUAL consensus cert, or '' sentinel for pre-finalization (Defect 6 fix — non-nullable)
  status               String   // exact BatchExecutionStatus (O1)
  receiptsDigest       String?  // SHA-256 of canonical receipts (O3)
  error                String?
  recordedAt           DateTime @default(now())

  @@unique([attemptId, finalityCertificate]) // O2: genuinely enforced (non-nullable, Defect 6 fix)
  @@index([attemptId])
  @@index([transactionId])
}

// =============================================================================
// Phase 12B Slice 2: Control-Plane Persistence Objects
// =============================================================================
// These models persist the generic control-plane objects defined in
// src/lib/control-plane/types.ts. They sit ABOVE the frozen kernel and are
// vertical-neutral.
//
// CRITICAL: these do NOT duplicate CapacityResource / CapacityReservation /
// CapacityCommitment. The existing capacity service remains authoritative
// for reservation/locking. The control plane calls it.
//
// Network Scope Integrity (§8.6): composite FKs enforce same-network where
// PostgreSQL permits. Service-layer checks also exist (in types.ts).
// =============================================================================

/// Phase 12B: ParticipantIdentity — global participant identity (one per org).
/// Has NO networkId — joins networks via ParticipantMembership.
model ParticipantIdentity {
  id              String   @id @default(cuid())
  organizationId  String?
  createdAt       DateTime @default(now())

  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  memberships     ParticipantMembership[]
  controlledResources ResourceIdentity[]
  // Phase 14A: Nodes associated with this participant (the economic actor).
  nodes           Node[]

  @@index([organizationId])
}

/// Phase 12B: ParticipantMembership — a participant's membership in a network.
/// Network-scoped. Has lifecycle (pending → active → suspended → revoked).
model ParticipantMembership {
  id              String   @id @default(cuid())
  participantId   String   // FK to ParticipantIdentity
  networkId       String   // the network this membership is in
  status          String   @default("pending") // pending | active | suspended | revoked
  joinedAt        DateTime @default(now())
  createdAt       DateTime @default(now())

  participant     ParticipantIdentity @relation(fields: [participantId], references: [id], onDelete: Cascade)
  roles           ParticipantRole[]
  resourceMemberships NetworkResourceMembership[]
  // Phase 14A: Node network memberships authorized by this participant membership.
  nodeMemberships NodeNetworkMembership[]

  @@unique([participantId, networkId]) // one membership per participant per network
  @@index([networkId])
  @@index([status])
}

/// Phase 12B: ParticipantRole — a role held by a participant within a
/// specific network membership. Separate from the membership so roles
/// can change independently.
model ParticipantRole {
  id              String   @id @default(cuid())
  membershipId    String   // FK to ParticipantMembership
  role            String   // provider | consumer | verifier | validator | orchestrator | observer
  status          String   @default("active") // active | suspended
  assignedAt      DateTime @default(now())
  revokedAt       DateTime?

  membership      ParticipantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, role]) // one role per type per membership
  @@index([membershipId])
  @@index([role])
}

/// Phase 12B: ResourceIdentity — global resource identity (one per physical/
/// logical resource). Has NO networkId — joins networks via
/// NetworkResourceMembership. Generalizes Asset.
model ResourceIdentity {
  id              String   @id @default(cuid())
  controllerId    String?   // FK to ParticipantIdentity (who controls it globally)
  resourceKind    String   // physical | compute | storage | connectivity | industrial | human | protocol
  status          String   @default("registering") // registering | active | suspended | decommissioned
  locationJson    String?  // geographic/topological (JSON)
  metadataJson    String   @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  controller      ParticipantIdentity? @relation(fields: [controllerId], references: [id], onDelete: SetNull)
  networkMemberships NetworkResourceMembership[]
  // Phase 14A: Nodes optionally backed by this resource (does not duplicate it).
  nodes           Node[]

  @@index([controllerId])
  @@index([resourceKind])
  @@index([status])
}

/// Phase 12B: NetworkResourceMembership — a resource's membership in a
/// specific network. Per-network bindings. Binds to ParticipantMembershipId
/// (the network-scoped authority). Generalizes AssetNetworkAssignment.
///
/// Network Scope Integrity: the service layer (in types.ts:
/// assertNetworkScopeIntegrity + authorizeRequest) enforces that the
/// ParticipantMembership's networkId matches this membership's networkId.
/// Prisma does not support composite FKs across different models with
/// different parent chains, so structural enforcement is at the service
/// layer, not the schema level. The service-layer check is tested by
/// the Phase 12B test suite.
model NetworkResourceMembership {
  id                      String   @id @default(cuid())
  resourceId              String   // FK to ResourceIdentity
  networkId               String   // the network
  participantMembershipId String   // FK to ParticipantMembership — network-scoped authority
  capabilitiesJson        String   @default("[]") // ["compute", "storage", ...]
  verifiedCapacityJson    String   @default("[]") // [{capabilityType, amount, unit}]
  controlMode             String   @default("default") // adapter selection
  verificationProfile      String   @default("default")
  availabilityStart       DateTime?
  availabilityEnd         DateTime?
  status                  String   @default("registering") // registering | active | suspended | withdrawn
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  resource                ResourceIdentity @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  participantMembership   ParticipantMembership @relation(fields: [participantMembershipId], references: [id], onDelete: Cascade)

  @@unique([resourceId, networkId]) // one membership per resource per network
  @@index([networkId])
  @@index([participantMembershipId])
  @@index([status])
}

/// Phase 12B: NetworkRequest — a durable, network-scoped request for
/// capability execution. Actor-neutral. The requestId is deterministic
/// (derived from networkId + requesterMembershipId + idempotencyKey).
///
/// IDEMPOTENCY: same (network, requester, idempotencyKey) → same requestId.
/// If the same key is used with a DIFFERENT payload, the persistence layer
/// detects the mismatch via payloadHash and returns IDEMPOTENCY_CONFLICT.
model NetworkRequest {
  id                      String   @id // deterministic: SHA-256(networkId, requesterMembershipId, idempotencyKey)
  requesterMembershipId   String   // FK to ParticipantMembership
  networkId               String
  networkVersionId        String   // REQUIRED: the published NetworkVersion policy bundle. Absent/unpublished → rejected.
  capabilityRequirementsJson String // canonical, sorted
  constraintsJson         String?  // canonical, sorted (optional)
  priority                Int?
  timeWindowStart         DateTime
  timeWindowEnd           DateTime
  idempotencyKey          String
  payloadHash             String   // SHA-256 of canonical request payload (for idempotency conflict detection)
  status                  String   @default("pending") // pending | scheduled | fulfilled | rejected | expired
  createdAt               DateTime @default(now())
  scheduledAt             DateTime?

  decision                AllocationDecision?

  @@unique([networkId, requesterMembershipId, idempotencyKey]) // C3: one request per identity
  @@index([networkId])
  @@index([requesterMembershipId])
  @@index([status])
}

/// Phase 12B: AllocationDecision — the durable output of the scheduler.
/// Stores the EXACT values produced by the pure scheduler, including
/// decisionSnapshotHash. The database never recomputes a different hash.
///
/// The decision record preserves the full audit trail (§8.7):
/// candidate memberships, selected membership, allocated capacity,
/// schedulerVersion, evaluatorVersion, decisionSnapshotHash.
///
/// The reservation binding is a COLLECTION (not a single reservationId)
/// because a multi-capability allocation can produce multiple reservations
/// — one per capability type. See AllocationReservation.
model AllocationDecision {
  id                      String   @id // deterministic: SHA-256 of semantic content
  requestId               String   // FK to NetworkRequest
  networkId               String
  candidateMembershipsJson String  // sorted array of membership IDs
  selectedMembershipId    String
  allocatedCapacityJson   String   // sorted array of {capabilityType, amount, unit}
  allocationWindowStart   DateTime
  allocationWindowEnd     DateTime
  priority                Int?
  schedulerVersion        String
  evaluatorVersion        String
  decisionSnapshotHash    String   // §8.7 — exact hash from the pure scheduler
  decidedAt               DateTime @default(now())
  expiresAt               DateTime
  status                  String   @default("active") // active | consumed | expired

  request                 NetworkRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  reservations            AllocationReservation[]

  @@unique([requestId]) // one decision per request
  @@index([networkId])
  @@index([selectedMembershipId])
  @@index([decisionSnapshotHash])
}

/// Phase 12B: AllocationReservation — the durable allocation-to-capacity
/// binding. One per allocated capability. Each entry records which
/// CapacityReservation backs which allocated capability.
///
/// This is a one-to-many relationship: one AllocationDecision can have
/// multiple AllocationReservations (one per capability type).
model AllocationReservation {
  id                      String   @id @default(cuid())
  decisionId              String   // FK to AllocationDecision
  capabilityType          String   // which capability this reservation backs
  unit                    String
  allocatedAmount         String
  reservationId           String   // FK to CapacityReservation
  createdAt               DateTime @default(now())

  decision                AllocationDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  // Phase 12B Slice 3: reverse relation to CapacityCommitment (the explicit
  // AllocationReservation → CapacityCommitment link).
  capacityCommitments     CapacityCommitment[]

  @@unique([decisionId, capabilityType, unit]) // one reservation per capability+unit per decision (multi-dimensional)
  @@index([decisionId])
  @@index([reservationId])
}

// -----------------------------------------------------------------------------
// Phase 14A: Node — a protocol participant endpoint.
// -----------------------------------------------------------------------------
// A Node is a protocol participation identity/endpoint. It is DISTINCT from
// Asset, Device, ParticipantIdentity, and ResourceIdentity (constitution §1).
//
//   Asset            — a physical/logical thing (battery, GPU, storage node).
//   Device           — the technical interface to an asset (controller, meter).
//   ParticipantIdentity — the economic/network participant identity (global).
//   ResourceIdentity — the universal resource abstraction (global).
//   Node             — a protocol participation endpoint (tenant-scoped).
//
// A single Node MAY be backed by an optional Device (and transitively an
// Asset) and MAY be associated with an optional ParticipantIdentity (the
// economic actor) and an optional ResourceIdentity. These are BINDINGS, not
// identity — a Node survives changes of device, IP, network, location, and
// transport. Node identity is an immutable cuid, never derived from device
// name, IP, MAC, network membership, or runtime process ID.
//
// A single Node participates in multiple networks/protocols via
// NodeNetworkMembership WITHOUT duplicating Device/Asset/ResourceIdentity
// rows. This is the multi-network participation proof (Phase 14A Step 8).
//
// IDENTITY RULES:
//   - Node.id is a cuid (immutable, random).
//   - Idempotent registration derives a deterministic nodeId from
//     SHA-256(tenantId, participantId, nodeKind, idempotencyKey). Concurrent
//     registerNode() calls with the same key converge to the same durable Node.
//   - deviceId/resourceId/displayName are bindings (mutable), NOT part of identity.
//
// LIFECYCLE: registered → active → suspended | revoked.
//   - registered: initial state, cannot join networks yet.
//   - active: can join/leave networks.
//   - suspended: cannot join new networks; existing memberships preserved.
//   - revoked: terminal; cannot join new networks.
//
// The Node does NOT contain: routing state, bundle storage, transform execution
// state, protocol-specific state, or economic state. Those belong to later
// boundaries (Data Plane, Bundle, Transform, economic pipeline).
// -----------------------------------------------------------------------------
model Node {
  id                      String   @id @default(cuid())
  tenantId                String
  participantId           String?  // FK to ParticipantIdentity (the economic actor)
  deviceId                String?  // FK to Device (optional backing device)
  resourceId              String?  // FK to ResourceIdentity (optional resource backing)
  nodeKind                String   // generic protocol endpoint kind (e.g. "protocol_endpoint")
  displayName             String
  status                  String   @default("registered") // registered | active | suspended | revoked
  protocolEligibilityJson String   @default("[]") // generic protocol kinds this node may participate in
  idempotencyKey          String   // caller-supplied, for deterministic registration
  payloadHash             String   // SHA-256 of canonical registration payload (conflict detection)
  metadataJson            String   @default("{}")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  tenant                  Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  participant              ParticipantIdentity?  @relation(fields: [participantId], references: [id], onDelete: SetNull)
  device                  Device?               @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  resource                ResourceIdentity?     @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  networkMemberships      NodeNetworkMembership[]
  // Phase 14B: bundles sourced by this Node (sender) + bundles delivered to
  // this Node (receiver). Both reference Node identity (protocol endpoint),
  // NOT Device/Asset/Resource.
  sentBundles             Bundle[]              @relation("BundleSourceNode")
  receivedBundles         Bundle[]              @relation("BundleDestinationNode")
  deliveries              BundleDelivery[]      @relation("BundleDeliveryNode")
  // Phase 14C: routes where this Node is source/destination + hops where this
  // Node is from/to + capability declarations + reachability state.
  sourcedRoutes           Route[]               @relation("RouteSourceNode")
  destinationRoutes       Route[]               @relation("RouteDestinationNode")
  routeHopsFrom           RouteHop[]            @relation("RouteHopFromNode")
  routeHopsTo             RouteHop[]            @relation("RouteHopToNode")
  capabilities            NodeCapability[]
  reachability            NodeReachability?
  // Phase 14D: transport capabilities + attempts where this Node is from/to.
  transportCapabilities   TransportCapability[]
  transportAttemptsFrom   TransportAttempt[]    @relation("TransportAttemptFromNode")
  transportAttemptsTo     TransportAttempt[]    @relation("TransportAttemptToNode")
  // Phase 14E: delivery confirmations issued by this Node (as receiver).
  deliveryConfirmations   DeliveryConfirmation[] @relation("DeliveryConfirmationReceiver")
  // Phase 14F: transform records applied by this Node.
  transformRecords        TransformRecord[]     @relation("TransformRecordNode")

  @@unique([tenantId, participantId, nodeKind, idempotencyKey]) // deterministic registration identity
  @@index([tenantId])
  @@index([participantId])
  @@index([deviceId])
  @@index([resourceId])
  @@index([status])
}

/// Phase 14A: NodeNetworkMembership — a Node's participation in a specific
/// network/protocol. This is DISTINCT from NetworkResourceMembership:
///
///   - NetworkResourceMembership binds a ResourceIdentity to a network (the
///     resource participates as a CAPACITY PROVIDER).
///   - NodeNetworkMembership binds a Node to a network (the node participates
///     as a PROTOCOL ENDPOINT).
///
/// These are separate relationships and MUST NOT be conflated. A Node and a
/// Resource MAY both participate in the same network via their respective
/// memberships without duplicating either.
///
/// Network Scope Integrity (§8.6): the participantMembershipId's networkId
/// MUST equal this membership's networkId. Enforced at the service layer via
/// assertNetworkScopeIntegrity (same pattern as NetworkResourceMembership).
///
/// One membership per node per network: @@unique([nodeId, networkId]).
/// Concurrent joinNetwork() calls converge to a single membership.
model NodeNetworkMembership {
  id                      String   @id @default(cuid())
  nodeId                  String   // FK to Node
  networkId               String   // the network/protocol
  participantMembershipId String   // FK to ParticipantMembership — network-scoped authority
  protocolRole            String   @default("participant") // generic protocol role
  status                  String   @default("active") // active | suspended | revoked
  joinedAt                DateTime @default(now())
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  node                    Node                @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  participantMembership   ParticipantMembership @relation(fields: [participantMembershipId], references: [id], onDelete: Cascade)

  @@unique([nodeId, networkId]) // one membership per node per network
  @@index([networkId])
  @@index([participantMembershipId])
  @@index([status])
}

// -----------------------------------------------------------------------------
// Phase 14B: Bundle — generic data-plane primitive.
// -----------------------------------------------------------------------------
// A Bundle is a transport/data-plane envelope capable of carrying arbitrary
// protocol payloads. It is DISTINCT from ProtocolTransaction (a deterministic
// state-transition request) and from VPP energy delivery.
//
// Bundle is NOT:
//   - a TransitNet packet
//   - a local-internet packet
//   - an HTTP request
//   - a blockchain transaction
//   - a compute job
//
// IDENTITY (Step 5):
//   - bundleId is DETERMINISTIC: SHA-256(tenantId, sourceNodeId, idempotencyKey).
//     Immutable, survives replication/crash/retry. payloadHash is NOT part of
//     the identity (it detects conflicts when the same key is reused with a
//     different payload).
//   - NOT derived from DB row ID, timestamp alone, route, storage node, or
//     network membership. A duplicate copy of the same Bundle retains the same
//     logical identity (enables dedup, retry, forwarding, replication).
//
// TENANCY (Step 6):
//   - tenant-scoped (source Node's tenant). A Bundle belongs to exactly one
//     tenant. Cross-tenant transport is a future routing concern — NOT in 14B.
//   - sourceNodeId + destinationNodeId both validated against the tenant.
//
// PAYLOAD BOUNDARY (Step 7):
//   - payloadType: generic string (e.g. "application/json", "opaque").
//   - payloadHash: SHA-256 of the payload (integrity).
//   - payloadRef: optional opaque reference for external content-addressed
//     storage (future). For Phase 14B, small payloads may be stored inline via
//     payloadBytesJson.
//   - Bundle metadata ≠ payload storage implementation.
//
// LIFECYCLE (Step 8):
//   status: created → received → stored → delivered | expired
//   - created: Bundle identity persisted, not yet received by destination.
//   - received: destination has acknowledged reception (may be stored).
//   - stored: persisted at an intermediate or final location.
//   - delivered: delivered to destination (at-least-once, idempotent).
//   - expired: past expiryTime; no new delivery permitted.
//   Delivery facts are SEPARATE (BundleDelivery, append-only) — stored,
//   forwarded, delivered, acknowledged are distinct facts, NOT conflated.
//
// DELIVERY SEMANTICS (Step 10):
//   at-least-once + idempotent delivery. NOT exactly-once. The Bundle layer
//   preserves facts rather than making unsupported guarantees. Delivery records
//   deduplicated by deterministic deliveryId.
//
// EXPIRY (Step 11):
//   expiryTime is a persisted timestamp. After expiry, new delivery is rejected.
//   Deterministic, NOT an in-memory timer.
//
// SECURITY/INTEGRITY (Step 13):
//   payloadHash (integrity), sourceNodeId (source identity), destinationNodeId
//   (destination identity), idempotencyKey + nonce (replay detection).
//   NO encryption algorithms — that belongs in future transform/security layers.
//
// NOT IN SCOPE (Step 16 hard stop):
//   routing, DTN, transforms, extensions, marketplace, SDK, Cloudlet, TransitNet.
// -----------------------------------------------------------------------------
model Bundle {
  id                      String   @id // deterministic: SHA-256(tenantId, sourceNodeId, idempotencyKey) — payloadHash NOT part of identity
  tenantId                String
  sourceNodeId            String   // FK to Node (sender — protocol endpoint identity)
  destinationNodeId       String   // FK to Node (receiver — protocol endpoint identity)
  nodeKind                String   // generic bundle kind (e.g. "generic_payload")
  payloadType             String   // generic content type (e.g. "application/json")
  payloadHash             String   // SHA-256 of payload (integrity)
  payloadRef              String?  // optional opaque reference to external storage
  payloadBytesJson        String?  // optional inline small payload (JSON string)
  priority                Int      @default(0) // generic, protocol-neutral
  nonce                   Int      @default(0) // replay detection
  idempotencyKey          String   // caller-supplied, for deterministic identity
  status                  String   @default("created") // created | received | stored | delivered | expired
  createdAt               DateTime @default(now())
  expiryTime              DateTime // persisted — after this, no new delivery
  deliveredAt             DateTime? // set when first delivered
  metadataJson            String   @default("{}")
  updatedAt               DateTime @updatedAt

  tenant                  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceNode              Node     @relation("BundleSourceNode", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  destinationNode         Node     @relation("BundleDestinationNode", fields: [destinationNodeId], references: [id], onDelete: Cascade)
  deliveries              BundleDelivery[]
  // Phase 14C: routes planned for this Bundle. Route ATTACHES to the Bundle —
  // it does NOT modify Bundle identity/payload/destination (Step 7).
  routes                  Route[]
  // Phase 14D: transport executions for this Bundle. TransportExecution
  // references the Bundle — it does NOT modify Bundle identity/payload (T2).
  transportExecutions     TransportExecution[]
  // Phase 14E: delivery confirmations for this Bundle. DeliveryConfirmation
  // references the Bundle — it does NOT modify Bundle identity/payload.
  deliveryConfirmations    DeliveryConfirmation[]
  // Phase 14F: transform records for this Bundle. TransformRecord references
  // the Bundle — it does NOT modify Bundle identity/payload.
  transformRecords         TransformRecord[]

  @@index([tenantId])
  @@index([sourceNodeId])
  @@index([destinationNodeId])
  @@index([status])
  @@index([expiryTime])
  @@index([priority])
}

/// Phase 14B: BundleDelivery — append-only delivery records. Each delivery
/// attempt/event is a separate fact, distinguished by status:
///   stored | forwarded | delivered | acknowledged | failed
///
/// Deduplication: @@unique([bundleId, receiverNodeId]) → same Bundle delivered
/// to the same receiver twice converges to ONE delivery record (idempotent).
/// The deliveryId is deterministic: SHA-256(bundleId, receiverNodeId).
///
/// This model does NOT conflate stored/forwarded/delivered/acknowledged —
/// they are distinct lifecycle facts recorded as separate status transitions.
/// For Phase 14B, the primary statuses are 'stored' and 'delivered'.
model BundleDelivery {
  id                      String   @id // deterministic: SHA-256(bundleId, receiverNodeId)
  bundleId                String   // FK to Bundle
  receiverNodeId          String   // FK to Node (who received/is receiving)
  tenantId                String   // denormalized for tenant-scoped queries
  status                  String   @default("stored") // stored | forwarded | delivered | acknowledged | failed
  attemptCount            Int      @default(1) // incremented on duplicate reception
  firstReceivedAt         DateTime @default(now())
  lastReceivedAt          DateTime @updatedAt
  deliveredAt             DateTime? // set when first delivered
  metadataJson            String   @default("{}")

  bundle                  Bundle   @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  receiverNode            Node     @relation("BundleDeliveryNode", fields: [receiverNodeId], references: [id], onDelete: Cascade)

  @@index([bundleId])
  @@index([receiverNodeId])
  @@index([tenantId])
  @@index([status])
}

// -----------------------------------------------------------------------------
// Phase 14C: Route — a planned path from source Node to destination Node.
// -----------------------------------------------------------------------------
// A Route is a routing plan ATTACHED to a Bundle. It represents WHERE a Bundle
// should go, NOT how it gets there physically. It is DISTINCT from:
//   - Bundle (the data-plane primitive — Route attaches to it, does NOT modify
//     Bundle identity/payload/destination, per Step 7).
//   - Node (the protocol endpoint — Route references Nodes, does not redefine
//     them).
//   - Transport (no TCP/UDP/Bluetooth/WiFi/satellite/DTN forwarding — Step 5).
//
// Route is immutable after creation (Step 6.1). Lifecycle:
//   planned → active → completed | failed | expired
// Route does NOT overload execution state (no forwarding/packet/connection).
//
// IDENTITY: cuid (immutable). NOT derived from Bundle or Node identity — a
// Route is a distinct planning artifact that may be revised by creating a new
// Route (the old one is NOT mutated).
//
// TENANCY: tenant-scoped (the Bundle's tenant). Cross-tenant routing is a
// future concern — NOT in Phase 14C.
//
// EXPIRY: persisted expiresAt timestamp. Expired routes cannot become active.
// -----------------------------------------------------------------------------
model Route {
  id                      String   @id @default(cuid())
  tenantId                String
  bundleId                String   // FK to Bundle — the Bundle this route plans for
  sourceNodeId            String   // FK to Node — route source (must match Bundle.sourceNodeId)
  destinationNodeId       String   // FK to Node — route destination (must match Bundle.destinationNodeId)
  status                  String   @default("planned") // planned | active | completed | failed | expired
  createdAt               DateTime @default(now())
  expiresAt               DateTime // persisted — after this, cannot become active
  completedAt             DateTime? // set when status → completed
  metadataJson            String   @default("{}")
  updatedAt               DateTime @updatedAt

  tenant                  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bundle                  Bundle   @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  sourceNode              Node     @relation("RouteSourceNode", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  destinationNode         Node     @relation("RouteDestinationNode", fields: [destinationNodeId], references: [id], onDelete: Cascade)
  hops                    RouteHop[]
  // Phase 14D: transport executions that execute this Route. TransportExecution
  // references the Route — it does NOT modify Route (T3).
  transportExecutions     TransportExecution[]

  @@index([tenantId])
  @@index([bundleId])
  @@index([sourceNodeId])
  @@index([destinationNodeId])
  @@index([status])
  @@index([expiresAt])
}

/// Phase 14C: RouteHop — an ordered hop in a route. A route consists of a
/// sequence of hops: Node A → Node B → Node C → Destination.
///
/// Hop ordering is deterministic via `sequence` (Int). @@unique([routeId,
/// sequence]) enforces no duplicate sequence numbers per route.
///
/// Each hop references fromNodeId + toNodeId (both must be active Nodes in the
/// tenant — R6: suspended/revoked Nodes cannot be added to new routes).
model RouteHop {
  id                      String   @id @default(cuid())
  routeId                 String   // FK to Route
  sequence                Int      // deterministic ordering (0, 1, 2, ...)
  fromNodeId              String   // FK to Node
  toNodeId                String   // FK to Node
  status                  String   @default("planned") // planned | active | completed | failed
  createdAt               DateTime @default(now())
  metadataJson            String   @default("{}")

  route                   Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  fromNode                Node     @relation("RouteHopFromNode", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode                  Node     @relation("RouteHopToNode", fields: [toNodeId], references: [id], onDelete: Cascade)

  @@unique([routeId, sequence]) // deterministic hop ordering
  @@index([routeId])
  @@index([fromNodeId])
  @@index([toNodeId])
  @@index([status])
}

/// Phase 14C: NodeCapability — the smallest capability declaration. Allows
/// future routing decisions to know what Nodes can participate in data-plane
/// operations. NOT a marketplace — just a declaration of capability.
///
/// Generic data-plane capabilities:
///   CAN_STORE_BUNDLE | CAN_FORWARD_BUNDLE | CAN_RECEIVE_BUNDLE | generic
///
/// A Node MAY have multiple capability declarations. This is knowledge, not
/// a capacity reservation or a marketplace listing.
model NodeCapability {
  id                      String   @id @default(cuid())
  tenantId                String
  nodeId                  String   // FK to Node
  capability              String   // CAN_STORE_BUNDLE | CAN_FORWARD_BUNDLE | CAN_RECEIVE_BUNDLE | generic
  status                  String   @default("active") // active | suspended | revoked
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  node                    Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([nodeId, capability]) // one declaration per capability per node
  @@index([nodeId])
  @@index([capability])
  @@index([status])
}

/// Phase 14C: NodeReachability — routing visibility. Represents KNOWLEDGE
/// about whether a Node is reachable, NOT proof of physical connectivity.
///
/// This is NOT a complete network graph. NOT topology discovery. Only enough
/// state to support future routing decisions.
///
/// Fields:
///   reachable: Boolean — best-effort reachability knowledge.
///   lastSeen: DateTime — when reachability was last confirmed.
///   latencyHint: Int? — optional generic latency hint (ms). NOT a measurement.
///   expiresAt: DateTime — when this knowledge expires (stale → re-check).
///
/// One reachability record per Node (@@unique([nodeId])).
model NodeReachability {
  id                      String   @id @default(cuid())
  tenantId                String
  nodeId                  String   @unique // FK to Node — one reachability record per node
  reachable               Boolean  @default(false)
  lastSeen                DateTime @default(now())
  latencyHint             Int?     // optional generic latency hint (ms)
  expiresAt               DateTime // when this knowledge expires
  metadataJson            String   @default("{}")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  node                    Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([reachable])
  @@index([expiresAt])
}

// -----------------------------------------------------------------------------
// Phase 14D: TransportExecution — one attempt to execute a Route.
// -----------------------------------------------------------------------------
// A TransportExecution represents one attempt to execute a Route (move a Bundle
// along its planned path). It is DISTINCT from:
//   - Bundle (the data-plane object — TransportExecution references it, does NOT
//     modify Bundle identity/payload, per T2).
//   - Route (the planned path — TransportExecution references it, does NOT
//     modify Route, per T3).
//   - InfrastructureAdapter (physical asset execution — TransportExecution is
//     data-plane transport, not asset telemetry/execute).
//
// TransportExecution is immutable in identity (cuid). Lifecycle:
//   created → started → completed | failed | cancelled
// A failed execution can create another execution attempt (T5 — failure recovery).
// Terminal states (completed, failed, cancelled) cannot transition back.
//
// IDENTITY: cuid (immutable). NOT derived from Bundle or Route identity — a
// TransportExecution is a distinct execution artifact. Multiple executions may
// exist for the same Route+Bundle (retries produce NEW executions).
//
// IDEMPOTENCY (T6): deterministic key (tenantId, routeId, bundleId,
// idempotencyKey) → concurrent createTransportExecution calls converge.
//
// TENANCY: tenant-scoped (the Route's tenant). Cross-tenant transport is a
// future concern — NOT in Phase 14D.
//
// The TransportExecution does NOT contain: TCP/UDP/sockets/network calls. It
// records execution STATE, not network behavior.
// -----------------------------------------------------------------------------
model TransportExecution {
  id                      String   @id @default(cuid())
  tenantId                String
  routeId                 String   // FK to Route — the planned path being executed
  bundleId                String   // FK to Bundle — the data-plane object being moved
  idempotencyKey          String   // caller-supplied, for deterministic identity
  status                  String   @default("created") // created | started | completed | failed | cancelled
  attemptNumber           Int      @default(1) // which attempt (1-based)
  failureReason           String?  // set when status → failed
  createdAt               DateTime @default(now())
  startedAt               DateTime? // set when status → started
  completedAt             DateTime? // set when status → completed or failed
  cancelledAt             DateTime? // set when status → cancelled
  metadataJson            String   @default("{}")
  updatedAt               DateTime @updatedAt

  tenant                  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  route                   Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  bundle                  Bundle   @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  attempts                TransportAttempt[]

  @@unique([tenantId, routeId, bundleId, idempotencyKey]) // deterministic registration identity
  @@index([tenantId])
  @@index([routeId])
  @@index([bundleId])
  @@index([status])
  @@index([attemptNumber])
}

/// Phase 14D: TransportAttempt — an individual transport attempt within an
/// execution. An execution may have multiple attempts (retries).
///
/// Attempts maintain deterministic ordering via `createdAt` (append-only).
/// Each attempt references fromNodeId + toNodeId (the hop being attempted).
///
/// Lifecycle: created → sent → acknowledged | failed
/// A failed attempt does NOT fail the execution (T5 — the execution can create
/// another attempt). The execution status is managed separately.
model TransportAttempt {
  id                      String   @id @default(cuid())
  executionId             String   // FK to TransportExecution
  attemptNumber           Int      // deterministic ordering (1-based, scoped to executionId)
  fromNodeId              String   // FK to Node — hop source
  toNodeId                String   // FK to Node — hop destination
  status                  String   @default("created") // created | sent | acknowledged | failed
  startedAt               DateTime @default(now())
  completedAt             DateTime? // set when acknowledged or failed
  errorCode               String?  // set when status → failed
  metadataJson            String   @default("{}")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  execution               TransportExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  fromNode                Node     @relation("TransportAttemptFromNode", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode                  Node     @relation("TransportAttemptToNode", fields: [toNodeId], references: [id], onDelete: Cascade)
  // Phase 14E: optional delivery confirmation for this attempt.
  confirmation            DeliveryConfirmation?

  @@unique([executionId, attemptNumber]) // deterministic ordering — one attempt per number per execution
  @@index([executionId])
  @@index([fromNodeId])
  @@index([toNodeId])
  @@index([status])
  @@index([createdAt])
}

/// Phase 14D: TransportCapability — node capability declaration for transport.
/// Similar to NodeCapability (Phase 14C) but specifically transport-oriented.
///
/// Allowed capabilities (generic, NOT transport-protocol-specific):
///   STORE_AND_FORWARD | BUNDLE_TRANSFER | TRANSPORT_EXECUTION | generic
///
/// NOT allowed (future adapter details):
///   WIFI | BLUETOOTH | LTE | SATELLITE | TCP | UDP | QUIC
///
/// A Node MAY have multiple transport capability declarations. This is a
/// declaration, NOT network ownership/bandwidth/pricing/connectivity (T8).
model TransportCapability {
  id                      String   @id @default(cuid())
  tenantId                String
  nodeId                  String   // FK to Node
  capability              String   // STORE_AND_FORWARD | BUNDLE_TRANSFER | TRANSPORT_EXECUTION | generic
  status                  String   @default("active") // active | suspended | revoked
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  node                    Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([nodeId, capability]) // one declaration per capability per node
  @@index([nodeId])
  @@index([capability])
  @@index([status])
}

// -----------------------------------------------------------------------------
// Phase 14E: DeliveryConfirmation — durable, immutable receipt that records
// receiver acknowledgment of a Bundle delivery / TransportAttempt.
// -----------------------------------------------------------------------------
// DeliveryConfirmation is the "acknowledge" data-plane operation from
// constitution §8, made real. It is DISTINCT from:
//   - TransportAttempt.acknowledged (a status flag — mutated).
//   - BundleDelivery.acknowledged (a status flag — reserved in 14B, not exercised).
//
// DeliveryConfirmation is an IMMUTABLE RECEIPT — it IS the acknowledgment fact.
// It records:
//   - WHO acknowledged (receiverNodeId)
//   - WHEN (confirmedAt — deterministic, persisted)
//   - WHAT (bundleId + optional transportAttemptId)
//   - PROOF (confirmationHash — integrity, links to the Bundle payloadHash)
//
// It does NOT replace the status flags — it ADDS a durable receipt layer on top.
// It does NOT modify Bundle, Route, Node, TransportExecution, or TransportAttempt.
//
// IDENTITY: cuid (immutable). Idempotent creation via deterministic key
// (tenantId, bundleId, receiverNodeId, idempotencyKey) → concurrent
// createDeliveryConfirmation calls converge.
//
// This is the hook for future reliability layers (retransmission, sliding
// windows, custody transfer — all future phases).
// -----------------------------------------------------------------------------
model DeliveryConfirmation {
  id                      String   @id @default(cuid())
  tenantId                String
  bundleId                String   // FK to Bundle — WHAT was confirmed
  transportAttemptId      String?  @unique // FK to TransportAttempt — optional 1:1 link to the attempt
  receiverNodeId          String   // FK to Node — WHO confirmed
  idempotencyKey          String   // caller-supplied, for deterministic identity
  confirmationHash        String   // integrity proof (links to Bundle.payloadHash)
  confirmedAt             DateTime @default(now()) // WHEN — deterministic, persisted
  metadataJson            String   @default("{}")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  tenant                  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bundle                  Bundle   @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  transportAttempt        TransportAttempt? @relation(fields: [transportAttemptId], references: [id], onDelete: SetNull)
  receiverNode            Node     @relation("DeliveryConfirmationReceiver", fields: [receiverNodeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, bundleId, receiverNodeId, idempotencyKey]) // deterministic registration identity
  @@index([tenantId])
  @@index([bundleId])
  @@index([transportAttemptId])
  @@index([receiverNodeId])
  @@index([confirmedAt])
}

// -----------------------------------------------------------------------------
// Phase 14F: TransformRecord — immutable provenance record that a specific
// transform was applied to a Bundle's payload, producing an output.
// -----------------------------------------------------------------------------
// TransformRecord is the "transform chain" from the dependency graph
// (Bundle → Transform chain → Delivery), made real as a durable provenance
// record. It is DISTINCT from:
//   - TransformRegistry (catalog of available transforms — future phase).
//   - TransformRuntime (execution engine that calls execute/reverse/verify —
//     future phase).
//   - Bundle (the data-plane object — TransformRecord references it, does NOT
//     modify Bundle identity/payload).
//
// TransformRecord IS the provenance fact — it records that a transform
// happened, not how to execute it. It captures (constitution §9 Transform
// Provenance):
//   - input hash + output hash + transform identity + transform version
//   + parameters + node + result
//
// It is IMMUTABLE (like DeliveryConfirmation). It is created once; it is
// never updated. It records:
//   - WHAT was transformed (bundleId + inputHash)
//   - WHAT transform was applied (transformType + transformVersion)
//   - WHO applied it (nodeId — optional, the Node that performed the transform)
//   - WHAT was produced (outputHash)
//   - WITH what parameters (parametersJson)
//   - WHAT was the result (resultStatus + resultMetadataJson)
//
// IDENTITY: cuid (immutable). Idempotent creation via deterministic key
// (tenantId, bundleId, nodeIdentity, transformType, idempotencyKey) → concurrent
// calls converge.
//
// This is the hook for future TransformRegistry (catalog) and TransformRuntime
// (execution) layers — they will consume/produce TransformRecords but do NOT
// exist in Phase 14F.
// -----------------------------------------------------------------------------
model TransformRecord {
  id                      String   @id @default(cuid())
  tenantId                String
  bundleId                String   // FK to Bundle — WHAT was transformed
  nodeId                  String?  // FK to Node — WHO applied the transform (optional, nullable)
  nodeIdentity            String   // non-null identity: nodeId if specified, else '__system__' — makes @@unique non-null
  transformType           String   // generic transform identity (e.g. "compression", "encryption_proxy")
  transformVersion        String   // transform version (semantic versioning string)
  inputHash               String   // SHA-256 of the input payload
  outputHash              String   // SHA-256 of the output payload
  parametersJson          String   @default("{}") // transform parameters (canonical JSON)
  resultStatus            String   @default("success") // success | failed — MATERIAL to fingerprint
  resultMetadataJson      String   @default("{}") // result details — NON-identity-bearing (observational)
  idempotencyKey          String   // caller-supplied, for deterministic identity
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  tenant                  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bundle                  Bundle   @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  node                    Node?    @relation("TransformRecordNode", fields: [nodeId], references: [id], onDelete: SetNull)

  // nodeIdentity is NON-NULL: it is nodeId when a Node is specified, or
  // '__system__' when no Node is attributable (system-applied transform).
  // This makes the unique constraint non-null, so PostgreSQL enforces
  // idempotency even for system-applied records (nodeId = NULL).
  // See Phase 14F correction: NULL in a UNIQUE constraint allows duplicates.
  @@unique([tenantId, bundleId, nodeIdentity, transformType, idempotencyKey]) // deterministic registration identity (non-null)
  @@index([tenantId])
  @@index([bundleId])
  @@index([nodeId])
  @@index([nodeIdentity])
  @@index([transformType])
  @@index([resultStatus])
  @@index([createdAt])
}

// -----------------------------------------------------------------------------
// WORK-010 (IAAS-DOM-ARCH-3 / DOM-015): TransformRegistry
//
// The service-layer catalog/discovery primitive for Transforms. Provides
// tenant-scoped registration, lookup by (transformType, transformVersion),
// version compatibility rules, certification metadata, and revocation metadata.
//
// Architectural boundaries (frozen by IAAS-DOM-ARCH-3):
//   - Service-layer, NOT kernel.
//   - Does NOT execute transforms (that is TransformRuntime — future).
//   - Does NOT import vertical services, EconomicPipeline, Route/Transport,
//     RuntimeRegistry, or kernel code.
//   - PostgreSQL is the durable source of registry metadata.
//   - Tenant isolation is mandatory.
//   - Deterministic idempotency: (tenantId, transformType, transformVersion)
//     is the stable identity tuple.
// -----------------------------------------------------------------------------
model TransformRegistryEntry {
  id                        String   @id @default(cuid())
  tenantId                  String
  transformType             String   // generic transform identity (e.g. "compression", "encryption_proxy")
  transformVersion          String   // semver string (e.g. "1.0.0")
  description               String   @default("") // human-readable description
  // Version compatibility: comma-separated list of compatible version ranges
  // (e.g. ">=1.0.0 <2.0.0"). The registry evaluates compatibility without
  // executing transforms.
  compatibleVersionsJson    String   @default("[]") // JSON array of compatibility rules
  // Certification metadata (DOM-015 §3): certifier identity + status.
  // Does NOT freeze a cryptographic mechanism — just records who certified
  // and the certification status.
  certifierIdentity         String?  // identity of the certifier (optional)
  certificationStatus       String   @default("uncertified") // uncertified | pending | certified | rejected
  certifiedAt               DateTime?
  // Revocation metadata (DOM-015 §4): status + reason + revokedAt.
  revocationStatus          String   @default("active") // active | revoked
  revocationReason          String?  // reason for revocation (if revoked)
  revokedAt                 DateTime?
  // Input/output constraints (metadata, not enforcement — enforcement is
  // TransformRuntime's responsibility, which is future).
  inputContentTypesJson     String   @default("[]") // JSON array of accepted content types
  outputContentTypesJson    String   @default("[]") // JSON array of produced content types
  reversibility             Boolean  @default(false)
  lossiness                 Boolean  @default(false)
  // Idempotency: deterministic identity tuple.
  idempotencyKey            String   // caller-supplied, for deterministic registration
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  tenant                    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Deterministic registration identity: one entry per (tenant, type, version).
  // Concurrent registrations with the same tuple converge (idempotent).
  @@unique([tenantId, transformType, transformVersion])
  @@index([tenantId])
  @@index([transformType])
  @@index([transformVersion])
  @@index([certificationStatus])
  @@index([revocationStatus])
  @@index([createdAt])
}
